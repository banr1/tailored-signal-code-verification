module

public import Arm64
public import ProofLib.ProgramReflection
public meta import Lean

/-!
# Literal AST Fetch and Decode Linter

Defines the `linter.literalFetch` option, the `literalFetchLinter` command linter, and the
`#lint_literal_fetches` / `#lint_literal_fetches!` audit commands. They flag hand-written
`fetch`, `fetchDecodeAt`, and `decode` lemma conclusions that spell out literal AArch64 AST
constructors instead of using `gen_fetches` or `gen_decodes`.
-/

namespace ProofLib.LiteralFetchLint

open Lean Meta Elab Command Linter Arm64 ProofLib.ProgramReflection

/-- Warn when hand-written fetch/decode lemma statements spell out literal AArch64 ISA AST
    constructors instead of using `gen_fetches` / `gen_decodes`. -/
public meta register_option linter.literalFetch : Bool := {
  defValue := true
  descr := "warn on literal ISA AST constructors in hand-written fetch/decode lemma statements; use `gen_fetches` or `gen_decodes` instead"
}

public meta section

/-- Persistent environment set recording every theorem generated by `gen_decodes` or
    `gen_fetches`, allowing `ProofLib.LiteralFetchLint` to exempt generated declarations
    automatically across module boundaries. -/
initialize generatedFetchDecodeExt : SimplePersistentEnvExtension Name NameSet ←
  registerSimplePersistentEnvExtension {
    addImportedFn := fun arrays =>
      arrays.foldl (init := {}) fun acc arr => arr.foldl NameSet.insert acc
    addEntryFn := fun s n => s.insert n
    toArrayFn := fun s => s.toArray
  }

/-- Tag attribute exempting an intentional test fixture or general library theorem from both
    `literalFetchLinter` and `#lint_literal_fetches` / `#lint_literal_fetches!`. -/
initialize nolintLiteralFetchAttr : TagAttribute ←
  registerTagAttribute `nolint_literal_fetch
    "exempt declaration from linter.literalFetch and #lint_literal_fetches"

private def hasSubstr (s sub : String) : Bool :=
  (s.splitOn sub).length > 1

private def isFetchOrDecodeDeclName (declName : Name) : Bool :=
  match declName with
  | .str _ s =>
    hasSubstr s "fetch_0x" || hasSubstr s "decode_0x" || s.endsWith "_rebase_fetch_base"
  | _ => false

private def isAuxiliaryDeclName (declName : Name) : Bool :=
  declName.isInternalDetail ||
    match declName with
    | .str _ s =>
      s.startsWith "_" || hasSubstr s "._proof_" || hasSubstr s ".match_" ||
        s.endsWith "._sunfold" || s.endsWith "._cstage1" || s.endsWith "._cstage2"
    | _ => false

private partial def findArm64Ctor? (env : Environment) (e : Expr) : Option Name :=
  match e with
  | .const c _ =>
    match env.find? c with
    | some (.ctorInfo ci) =>
      if ci.induct.getRoot == `Arm64 then some c else none
    | _ => none
  | .app f a => (findArm64Ctor? env f).orElse (fun _ => findArm64Ctor? env a)
  | .lam _ d b _ | .forallE _ d b _ =>
    (findArm64Ctor? env d).orElse (fun _ => findArm64Ctor? env b)
  | .letE _ t v b _ =>
    (findArm64Ctor? env t).orElse fun _ =>
      (findArm64Ctor? env v).orElse (fun _ => findArm64Ctor? env b)
  | .mdata _ b | .proj _ _ b => findArm64Ctor? env b
  | _ => none

private partial def containsNumericLit (e : Expr) : Bool :=
  match e with
  | .lit (.natVal _) => true
  | .app f a =>
    if e.isAppOfArity ``OfNat.ofNat 3 then true
    else if e.isAppOfArity ``BitVec.ofNat 2 then
      match a with
      | .lit (.natVal _) => true
      | _ => containsNumericLit a
    else
      containsNumericLit f || containsNumericLit a
  | .lam _ d b _ | .forallE _ d b _ => containsNumericLit d || containsNumericLit b
  | .letE _ t v b _ => containsNumericLit t || containsNumericLit v || containsNumericLit b
  | .mdata _ b | .proj _ _ b => containsNumericLit b
  | _ => false

private partial def stripRebase (e : Expr) : Expr :=
  if e.isAppOfArity ``Arm64.Program.rebase 4 then
    stripRebase (e.getArg! 0)
  else
    e

private partial def containsFetchOrDecodeConst (e : Expr) : Bool :=
  match e with
  | .app f a =>
    let direct :=
      if e.isAppOfArity ``Arm64.Program.fetch 2 then
        !(stripRebase (e.getArg! 0)).hasLooseBVars
      else if e.isAppOfArity ``WordTree.fetchDecodeAt 2 then
        !(e.getArg! 0).hasLooseBVars
      else if e.isAppOfArity ``Arm64.decode 1 then
        !a.hasLooseBVars && containsNumericLit a
      else
        false
    direct || containsFetchOrDecodeConst f || containsFetchOrDecodeConst a
  | .lam _ d b _ | .forallE _ d b _ =>
    containsFetchOrDecodeConst d || containsFetchOrDecodeConst b
  | .letE _ t v b _ =>
    containsFetchOrDecodeConst t || containsFetchOrDecodeConst v || containsFetchOrDecodeConst b
  | .mdata _ b | .proj _ _ b => containsFetchOrDecodeConst b
  | _ => false

private partial def hasPolymorphicFetchTarget (e : Expr) : Bool :=
  match e with
  | .app f a =>
    let direct :=
      if e.isAppOfArity ``Arm64.Program.fetch 2 then
        (stripRebase (e.getArg! 0)).hasLooseBVars
      else if e.isAppOfArity ``WordTree.fetchDecodeAt 2 then
        (e.getArg! 0).hasLooseBVars
      else if e.isAppOfArity ``Arm64.decode 1 then
        a.hasLooseBVars
      else
        false
    direct || hasPolymorphicFetchTarget f || hasPolymorphicFetchTarget a
  | .lam _ d b _ | .forallE _ d b _ =>
    hasPolymorphicFetchTarget d || hasPolymorphicFetchTarget b
  | .letE _ t v b _ =>
    hasPolymorphicFetchTarget t || hasPolymorphicFetchTarget v || hasPolymorphicFetchTarget b
  | .mdata _ b | .proj _ _ b => hasPolymorphicFetchTarget b
  | _ => false

private partial def peelForalls : Expr → Expr
  | .forallE _ _ b _ => peelForalls b
  | .mdata _ b => peelForalls b
  | e => e

private partial def peelLambdas : Expr → Expr
  | .lam _ _ b _ => peelLambdas b
  | .mdata _ b => peelLambdas b
  | e => e

private partial def isPropResultType (e : Expr) : Bool :=
  (peelForalls e).isProp

private partial def splitAndConjuncts (e : Expr) : Array Expr :=
  let e := peelForalls e
  if e.isAppOfArity ``And 2 then
    splitAndConjuncts (e.getArg! 0) ++ splitAndConjuncts (e.getArg! 1)
  else
    #[e]

private def checkConclusionExpr? (env : Environment) (declName : Name) (concl : Expr) :
    Option Name := Id.run do
  let nameMatches := isFetchOrDecodeDeclName declName
  for conj in splitAndConjuncts concl do
    if conj.isAppOfArity ``Eq 3 then
      let lhs := conj.getArg! 1
      let rhs := conj.getArg! 2
      if containsFetchOrDecodeConst lhs || (nameMatches && !hasPolymorphicFetchTarget lhs) then
        if rhs.isAppOfArity ``Option.some 2 then
          if let some ctor := findArm64Ctor? env (rhs.getArg! 1) then
            return some ctor
  return none

/-- Inspect a compiled `ConstantInfo` for hand-written literal-AST fetch/decode conclusions. -/
def checkConstantInfo? (env : Environment) (declName : Name) (ci : ConstantInfo) : Option Name :=
  if isAuxiliaryDeclName declName then
    none
  else if (generatedFetchDecodeExt.getState env).contains declName then
    none
  else if nolintLiteralFetchAttr.hasTag env declName then
    none
  else
    match checkConclusionExpr? env declName (peelForalls ci.type) with
    | some ctor => some ctor
    | none =>
      match ci with
      | .defnInfo di =>
        if isPropResultType di.type then
          checkConclusionExpr? env declName (peelForalls (peelLambdas di.value))
        else
          none
      | _ => none

private partial def collectIdentsAndDots (stx : Syntax) (acc : Array String := #[]) :
    Array String :=
  match stx with
  | .ident _ rawVal id _ =>
    let s := id.toString
    let raw := rawVal.toString
    acc.push (if raw.startsWith "." then raw else s)
  | .node _ kind args =>
    let acc :=
      if kind == ``Lean.Parser.Term.dotIdent && args.size ≥ 2 then
        acc.push ("." ++ args[1]!.getId.toString)
      else
        acc
    args.foldl (fun a child => collectIdentsAndDots child a) acc
  | .atom _ val => acc.push val
  | .missing => acc

private def syntaxConclusionHasLiteralAst? (declName : Name) (typeStx : Syntax) : Option String := Id.run do
  let toks := collectIdentsAndDots typeStx
  let mut lastArrow : Option Nat := none
  let mut depth : Int := 0
  for idx in [:toks.size] do
    let t := toks[idx]!
    if t == "(" || t == "[" || t == "{" then depth := depth + 1
    else if t == ")" || t == "]" || t == "}" then depth := max 0 (depth - 1)
    else if depth == 0 && (t == "→" || t == "->") then lastArrow := some idx
  let slice := match lastArrow with
    | some k => toks.extract (k + 1) toks.size
    | none => toks
  let hasDigitTok := fun (t : String) =>
    match t.toList with
    | c :: _ => c.isDigit
    | [] => false
  let hasFetchCall :=
    (slice.any fun t =>
      t == "fetch" || t.endsWith ".fetch" || t == "fetchDecodeAt" || t.endsWith ".fetchDecodeAt") ||
    ((slice.any fun t => t == "decode" || t == "Arm64.decode") && slice.any hasDigitTok)
  if !isFetchOrDecodeDeclName declName && !hasFetchCall then
    return none
  for idx in [:slice.size] do
    if slice[idx]! == "=" && idx + 1 < slice.size &&
        (slice[idx + 1]! == "some" || slice[idx + 1]! == "Option.some") then
      for j in [idx + 2 : slice.size] do
        let tok := slice[j]!
        if tok == "∧" || tok == "/\\" then break
        if tok.startsWith "." && tok.length > 1 && tok != ".." then
          return some tok
        for pfx in #["Instr.", "Operation.", "Reg.", "AddrMode.", "RegWidth.", "GprWidth.",
            "MemWidth.", "CondCode.", "AddSubOp.", "LogicalOp.", "BitfieldOp.",
            "MoveWideOp.", "ShiftType.", "ExtendType.", "SimdMemSize."] do
          if tok.startsWith pfx && tok.length > pfx.length then
            return some tok
  return none

private def lintMessage (declName : Name) (ctorStr : String) : MessageData :=
  m!"declaration `{declName}` states a literal ISA AST constructor (`{ctorStr}`) in a fetch/decode conclusion; generate fetch/decode lemmas with `gen_fetches` or `gen_decodes` (`ProofLib.GenDecodes`) instead of writing literal instruction syntax by hand"

private def extractDeclHeader? (cmdStx : Syntax) : Option (Syntax × Name × Syntax) := Id.run do
  let mut cur := cmdStx
  for _ in [:8] do
    if cur.getKind == ``Lean.Parser.Command.declaration && cur.getNumArgs ≥ 2 then
      let body := cur[1]
      if body.getNumArgs ≥ 3 then
        let declId := body[1]
        let rawId := if declId.getKind == ``Lean.Parser.Command.declId && declId.getNumArgs ≥ 1 then
          declId[0] else declId
        let id := rawId.getId
        let sig := body[2]
        let retStx := if sig.getNumArgs ≥ 2 then sig[1] else Syntax.missing
        if !id.isAnonymous then
          return some (rawId, id, retStx)
      return none
    if cur.getNumArgs > 0 then
      cur := cur[cur.getNumArgs - 1]!
    else
      return none
  return none

/-- Automatic command linter flagging literal AArch64 AST constructors in hand-written
    fetch/decode lemma statements. Controlled by `set_option linter.literalFetch true|false`. -/
def literalFetchLinter : Linter where
  run := withSetOptionIn fun cmdStx => do
    let some (idStx, shortId, sigStx) := extractDeclHeader? cmdStx | return
    let ns ← getCurrNamespace
    let isRoot := shortId.getRoot == `_root_
    let normId := if isRoot then shortId.replacePrefix `_root_ .anonymous else shortId
    let fullCand := if isRoot then normId else ns ++ normId
    let enabled := getLinterValue linter.literalFetch (← getLinterOptions)
    let env ← getEnv
    let resolved? : Option (Name × ConstantInfo) :=
      match env.find? fullCand with
      | some ci => some (fullCand, ci)
      | none =>
        let privCand := mkPrivateName env fullCand
        match env.find? privCand with
        | some ci => some (privCand, ci)
        | none =>
          match env.find? normId with
          | some ci => some (normId, ci)
          | none => none
    if !enabled then
      return
    match resolved? with
    | some (declName, ci) =>
      if let some ctor := checkConstantInfo? env declName ci then
        Linter.logLint linter.literalFetch idStx (lintMessage declName ctor.toString)
    | none =>
      if let some ctorStr := syntaxConclusionHasLiteralAst? fullCand sigStx then
        Linter.logLint linter.literalFetch idStx (lintMessage fullCand ctorStr)

initialize addLinter literalFetchLinter

/-- Audit declarations in the current module (or all imported modules matching `modPrefix?`)
    for hand-written literal-AST fetch/decode statements. -/
def runLintLiteralFetches (strict : Bool) (modPrefix? : Option Name) : CommandElabM Unit := do
  let env ← getEnv
  let mut hits : Array (Name × Name) := #[]
  match modPrefix? with
  | none =>
    for (declName, ci) in env.constants.map₂.toList do
      if let some ctor := checkConstantInfo? env declName ci then
        hits := hits.push (declName, ctor)
  | some pfx =>
    let matchMod (m : Name) : Bool :=
      (m == pfx || pfx.isPrefixOf m) &&
        !(pfx == `ProofLib && (`ProofLib.Testing == m || (`ProofLib.Testing).isPrefixOf m))
    for modIdx in [:env.header.moduleNames.size] do
      let modName := env.header.moduleNames[modIdx]!
      if matchMod modName then
        if h : modIdx < env.header.moduleData.size then
          let mdata := env.header.moduleData[modIdx]
          for idx in [:mdata.constNames.size] do
            if h2 : idx < mdata.constants.size then
              let declName := mdata.constNames[idx]!
              let ci := mdata.constants[idx]
              if let some ctor := checkConstantInfo? env declName ci then
                hits := hits.push (declName, ctor)
    if matchMod env.mainModule then
      for (declName, ci) in env.constants.map₂.toList do
        if let some ctor := checkConstantInfo? env declName ci then
          hits := hits.push (declName, ctor)
  let sorted := hits.qsort (fun a b => a.1.lt b.1)
  if sorted.isEmpty then
    return
  for (declName, ctor) in sorted do
    let msg := lintMessage declName ctor.toString
    if strict then
      logError msg
    else
      logWarning msg

end

/-- Audit hand-written fetch/decode declarations in the current module (or matching imported
    module prefix) for literal ISA AST constructors, emitting warnings. -/
elab "#lint_literal_fetches" mod?:(ppSpace ident)? : command => do
  runLintLiteralFetches false (mod?.map (·.getId))

/-- Strict CI-gate variant of `#lint_literal_fetches`: emits errors when any hand-written
    declaration states literal ISA AST constructors in a fetch/decode conclusion. -/
elab "#lint_literal_fetches!" mod?:(ppSpace ident)? : command => do
  runLintLiteralFetches true (mod?.map (·.getId))

end ProofLib.LiteralFetchLint
