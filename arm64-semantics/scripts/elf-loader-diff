#!/usr/bin/env bash
# Build the static AArch64 ELF loader corpus, capture `qemu-aarch64` entry snapshots
# via `proc-snapshot --entry-only`, and run the Lean `ElfImage.loadState` differential harness.
#
# Usage:
#   scripts/elf-loader-diff build [--check]
#   scripts/elf-loader-diff regen [--check]
#   scripts/elf-loader-diff run
#
# Examples:
#   scripts/elf-loader-diff build --check
#   scripts/elf-loader-diff regen --check
#   scripts/elf-loader-diff run
set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | sed '$d; s/^# \{0,1\}//'
  exit 0
fi

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec cargo run --release --locked --manifest-path "$REPO_ROOT/tools/Cargo.toml" \
  --bin elf_loader_diff -- --root "$REPO_ROOT" "$@"
