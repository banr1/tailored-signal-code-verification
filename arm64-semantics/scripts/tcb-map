#!/usr/bin/env bash
# Print the repository TCB trust hierarchy (`--tree` / `--tree-json`) or enforce core
# TCB/Spec/Proof/Theorems import and role-purity boundaries (`--check` / `--check-imports`).
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

for arg in "$@"; do
  if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
    cat <<'EOF'
Usage:
  scripts/tcb-map [--tree] [--tree-json] [--check-imports] [--check] [--no-case-studies] [--root <PATH>]

Print the repository TCB trust hierarchy or enforce core TCB/Spec/Proof/Theorems boundaries.

Flags / Options:
  --tree             Print the directory-hierarchy trust classification (`[tcb]`, `[proof]`, etc.)
  --tree-json        Print the trust classification and code-size metrics as JSON
  --check-imports    Check strictly import-order / package DAG and TCB Rust imports
  --check            Check imports, unclassified paths, and core role-purity / soundness rules (default)
  --no-case-studies  Exclude case studies from the check and `--tree` output
  --root <DIR>       Override repository root directory
  -h, --help         Show this help message and exit

Examples:
  scripts/tcb-map --tree
  scripts/tcb-map --tree-json
  scripts/tcb-map --check-imports
  scripts/tcb-map --check
EOF
    exit 0
  fi
done

if [[ -x "$REPO_ROOT/scripts/dev/tool-bin-fresh.sh" ]]; then
  exec "$REPO_ROOT/scripts/dev/tool-bin-fresh.sh" run tcb-map -- --root "$REPO_ROOT" "$@"
fi
exec cargo run --release --quiet --locked --manifest-path "$REPO_ROOT/tools/Cargo.toml" --bin tcb-map -- --root "$REPO_ROOT" "$@"
