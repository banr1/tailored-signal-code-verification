module

public meta import Lean
public import LibsignalBinary.Specifications.SignalSession.Run

/-!
Pre-elaborated CLI `Inputs`, stdout byte lists, and exit filesystem snapshots for the three calls
of the `Cheval26SmallSubgroupHighBitCli` witness. The local `fast_hex_chunks` elaborator builds
`List (BitVec 8)` literals directly in constructor WHNF at elaboration time to avoid kernel string
reduction blowups and keep per-call proof files independent of `ImplTrace`.
-/

@[expose] public section

set_option autoImplicit false

namespace Symbolic.BugInjection.Disproofs.Impl.SmallSubgroup.FastInputs

open CryptoVerification.SignalSession (Inputs)

section HexElab
open Lean (Expr TSyntax mkApp mkApp2 mkApp3 mkConst mkNatLit)

private meta def hexNib (c : Char) : Nat :=
  if '0' ≤ c && c ≤ '9' then c.toNat - '0'.toNat
  else if 'a' ≤ c && c ≤ 'f' then c.toNat - 'a'.toNat + 10
  else if 'A' ≤ c && c ≤ 'F' then c.toNat - 'A'.toNat + 10
  else 0

private meta def mkBVExpr (w val : Nat) : Expr :=
  mkApp2 (mkConst ``BitVec.ofNat) (mkNatLit w) (mkNatLit val)

private meta def mkByteListFromHex (s : String) : Expr := Id.run do
  let bv8 := mkApp (mkConst ``BitVec) (mkNatLit 8)
  let mut acc := mkApp (mkConst ``List.nil [0]) bv8
  let arr := s.toByteArray
  let n := arr.size / 2
  for idx in [0:n] do
    let revIdx := n - 1 - idx
    let hi := hexNib (Char.ofNat (arr.get! (2 * revIdx)).toNat)
    let lo := hexNib (Char.ofNat (arr.get! (2 * revIdx + 1)).toNat)
    let v := 16 * hi + lo
    acc := mkApp3 (mkConst ``List.cons [0]) bv8 (mkBVExpr 8 v) acc
  return acc

end HexElab

local elab "fast_hex_chunks " "[" chunks:str,* "]" : term => do
  let strs := chunks.getElems.map (·.getString)
  return mkByteListFromHex (String.join strs.toList)

