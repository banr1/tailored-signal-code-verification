module

public meta import Lean
public import LibsignalBinary.Specifications.SignalSession.Run

/-!
Pre-elaborated byte blobs, expected stdout payloads, post-step directory file lists, and per-call
`Inputs` records for the 7-call `cheval26-weak-state` CLI witness.

The local `fast_hex_chunks` elaborator builds constructor-WHNF `List (BitVec 8)` expressions
directly at elaboration time so downstream call proofs avoid kernel reduction of hex strings and
do not depend on `ImplTrace`.
-/

@[expose] public section

set_option autoImplicit false

namespace Symbolic.BugInjection.Disproofs.Impl.WeakState.FastInputs

open CryptoVerification.SignalSession (Inputs)

section ElabHelpers
open Lean (Expr TSyntax mkApp mkApp2 mkApp3 mkConst mkNatLit)

private meta def hexNib (c : Char) : Nat :=
  if '0' ≤ c && c ≤ '9' then c.toNat - '0'.toNat
  else if 'a' ≤ c && c ≤ 'f' then c.toNat - 'a'.toNat + 10
  else if 'A' ≤ c && c ≤ 'F' then c.toNat - 'A'.toNat + 10
  else 0

private meta def mkBVExpr (w val : Nat) : Expr :=
  mkApp2 (mkConst ``BitVec.ofNat) (mkNatLit w) (mkNatLit val)

private meta def mkByteListFromHex (s : String) : Expr := Id.run do
  let bv8 := mkApp (mkConst ``BitVec) (mkNatLit 8)
  let mut acc := mkApp (mkConst ``List.nil [0]) bv8
  let arr := s.toByteArray
  let n := arr.size / 2
  for idx in [0:n] do
    let revIdx := n - 1 - idx
    let hi := hexNib (Char.ofNat (arr.get! (2 * revIdx)).toNat)
    let lo := hexNib (Char.ofNat (arr.get! (2 * revIdx + 1)).toNat)
    let v := 16 * hi + lo
    acc := mkApp3 (mkConst ``List.cons [0]) bv8 (mkBVExpr 8 v) acc
  return acc

end ElabHelpers

local elab "fast_hex_chunks " "[" ss:str,* "]" : term => do
  let joined := String.join (ss.getElems.toList.map Lean.TSyntax.getString)
  return mkByteListFromHex joined

