  have hmac_pin : keyOfTake8 ((gamma compI0 S g (macNode38Gen tr₁ tr₂ b ikA ikBPk spkPk pqPk cl)).take 8) = some sentMacKey := by
    have hu_mac' : (gamma compI0 S g (macNode38Gen tr₁ tr₂ b ikA ikBPk spkPk pqPk cl)).take 4 ≠ compTag4 := (by unfold macNode38Gen; dsimp only; rw [← encKeys_eq_trMsgKeys_ini tr₁ tr₂ b o cl]; exact hu_mac)
    have hrec := gamma_hmac_key_of_take8 S g (node13Gen tr₁ b ikA ikBPk spkPk pqPk ⟨11, by decide⟩)
