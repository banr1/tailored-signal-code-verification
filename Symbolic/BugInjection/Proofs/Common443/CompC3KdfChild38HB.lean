def sentZprk0 : HwBytes := hmacWith F0 zeros32 ssSeed0
theorem sentZprk0_tag4 : sentZprk0.take 4 = compTag4 := by decide +kernel
theorem compHmacKeys32_untagged : ∀ k ∈ compHmacKeys32, k.take 4 ≠ compTag4 := by decide +kernel
def sentVal13 : Fin 13 → HwBytes
  | ⟨0, _⟩ => ssPqxdhPrk0 | ⟨1, _⟩ => ssRk0 | ⟨2, _⟩ => ssPqxdhCk0 | ⟨3, _⟩ => ssPqxdhPqr0
  | ⟨4, _⟩ => ssChainPrk0 | ⟨5, _⟩ => ssStARk0 | ⟨6, _⟩ => ssCks0 | ⟨7, _⟩ => ssCks1
  | ⟨8, _⟩ => ssSeed0 | ⟨9, _⟩ => sentPrk | ⟨10, _⟩ => ssCipherKey0 | ⟨11, _⟩ => sentMacKey
  | ⟨12, _⟩ => ssIv0
theorem sentVal13_beq_eq : ∀ i j : Fin 13, (sentVal13 i == sentVal13 j) = (i == j) := by decide +kernel
theorem sentVal13_inj {i j : Fin 13} (h : sentVal13 i = sentVal13 j) : i = j := by have hb : (sentVal13 i == sentVal13 j) = true := beq_iff_eq.mpr h; rw [sentVal13_beq_eq] at hb; exact beq_iff_eq.mp hb
theorem sentVal13_keyOfTake8_ne : ∀ i : Fin 13, (keyOfTake8 ((sentVal13 i).take 8) == some sentMacKey) = false := by decide +kernel
theorem sentVal13_keyOfTake8_ne_some_sentMacKey (i : Fin 13) : keyOfTake8 ((sentVal13 i).take 8) ≠ some sentMacKey := by intro h; have hb : (keyOfTake8 ((sentVal13 i).take 8) == some sentMacKey) = true := beq_iff_eq.mpr h; rw [sentVal13_keyOfTake8_ne i] at hb; cases hb
