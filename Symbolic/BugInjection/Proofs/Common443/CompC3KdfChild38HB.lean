  have hzprk : gamma compI0 S g (zprkT stA) = sentZprk0 := by unfold zprkT sentZprk0; rw [CompRNbsc38MacKey.gamma_hmac_compI0, gamma_zeroKey, hseed]
  have hzprk_tag : (gamma compI0 S g (zprkT stA)).take 4 = compTag4 := hzprk ▸ sentZprk0_tag4; have hzprk_len : (gamma compI0 S g (zprkT stA)).length = 32 := CompRNbsc38MacKey.gamma_hmac_length S g _ _; have hmk_tag : (hmacWith F0 (gamma compI0 S g (zprkT stA)) (hmacWith F0 (gamma compI0 S g (zprkT stA)) (zInfo ++ [1#8]) ++ (zInfo ++ [2#8]))).take 4 = compTag4 := hmacWith_take4_of_key_tagged hzprk_len hzprk_tag; have hmk_len : (hmacWith F0 (gamma compI0 S g (zprkT stA)) (hmacWith F0 (gamma compI0 S g (zprkT stA)) (zInfo ++ [1#8]) ++ (zInfo ++ [2#8]))).length = 32 := (by rw [← gamma_zmacKey S g stA]; exact gamma_macKey_length S g _ _); have hm := List.mem_map_of_mem (f := gamma compI0 S g) hu; rw [gamma_take5] at hm; simp only [zChain, List.mem_cons, List.not_mem_nil, or_false] at hm
  rcases hm with h0 | h1 | h2 | h3 | h4 <;> [exact h0 ▸ hzprk_tag; exact h1 ▸ hmacWith_take4_of_key_tagged hzprk_len hzprk_tag; exact h2 ▸ hmk_tag; exact h3 ▸ hmacWith_take4_of_key_tagged hzprk_len hzprk_tag; (rw [h4]; unfold zfullT; rw [CompRNbsc38MacKey.gamma_hmac_compI0, gamma_zmacKey]; exact hmacWith_take4_of_key_tagged hmk_len hmk_tag)]
theorem zeroSalted_kdf_tag4_of_sentSeed {S : Sem} {g : Ghost} {tr₂ : ExecTrace} {stA : DY.Libsignal.TripleRatchet.TRState} {cl pq : Nat} (hseed : gamma compI0 S g (DY.Libsignal.TripleRatchet.kdfCk stA.cks).2 = ssSeed0) {u k m : DY.Bytes} (hu : u ∈ zeroSaltedTermsStA tr₂ stA cl pq) (hkdf : u = DY.KdfExtract.kdfExtract k m) : (gamma compI0 S g u).take 4 = compTag4 := by
