def SentNodePin38Gen (S : Sem) (g : Ghost) (tr₁ tr₂ : ExecTrace) (b : DY.Participant) (ikA ikBPk spkPk pqPk : DY.Bytes) (cl : Nat) (t : DY.Bytes) : Prop := (∃ i : Fin 13, t = node13Gen tr₁ b ikA ikBPk spkPk pqPk i ∧ gamma compI0 S g t = sentVal13 i) ∨ (t = macNode38Gen tr₁ tr₂ b ikA ikBPk spkPk pqPk cl ∧ keyOfTake8 ((gamma compI0 S g t).take 8) = some sentMacKey)
abbrev SentNodePin38 (S : Sem) (g : Ghost) (r : Records) (tr₁ tr₂ : ExecTrace) (cl : Nat) (t : DY.Bytes) : Prop := SentNodePin38Gen S g tr₁ tr₂ r.bob (setupSecret r 0) (setupPublic r 2) (setupPublic r 4) (setupPublic r 6) cl t
theorem sentNodePin38Gen_inj {S : Sem} {g : Ghost} {tr₁ tr₂ : ExecTrace} {b : DY.Participant} {ikA ikBPk spkPk pqPk : DY.Bytes} {cl : Nat} {t₁ t₂ : DY.Bytes} (h₁ : SentNodePin38Gen S g tr₁ tr₂ b ikA ikBPk spkPk pqPk cl t₁) (h₂ : SentNodePin38Gen S g tr₁ tr₂ b ikA ikBPk spkPk pqPk cl t₂) (he : gamma compI0 S g t₁ = gamma compI0 S g t₂) : t₁ = t₂ := by
  rcases h₁ with ⟨i, rfl, hi⟩ | ⟨rfl, h1⟩ <;> rcases h₂ with ⟨j, rfl, hj⟩ | ⟨rfl, h2⟩
  · rw [sentVal13_inj (hi.symm.trans (he.trans hj))]
  · rw [← he, hi] at h2; exact absurd h2 (sentVal13_keyOfTake8_ne_some_sentMacKey i)
  · rw [he, hj] at h1; exact absurd h1 (sentVal13_keyOfTake8_ne_some_sentMacKey j)
  · rfl
