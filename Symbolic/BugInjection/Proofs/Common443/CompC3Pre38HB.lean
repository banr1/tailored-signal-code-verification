theorem gamma_symEnc_untagged_of_compAesPt0 {S : Sem} {g : Ghost} {k iv m : DY.Bytes}
    (hk : gamma compI0 S g k = ssCipherKey0) (hiv : gamma compI0 S g iv = ssIv0)
    (hm : gamma compI0 S g m = compAesPt0) :
    (gamma compI0 S g (DY.SymEnc.symEnc k iv m)).take 4 ≠ compTag4 := by
  have hγ : gamma compI0 S g (DY.SymEnc.symEnc k iv m) = compAesPerm (gamma compI0 S g k) ((gamma compI0 S g iv).take 16) (gamma compI0 S g m) := by
    unfold gamma gamma'
    rw [show DY.SymEnc.symEnc k iv m = ({ key := k, iv := iv, msg := m } : DY.SymEnc.Enc.SubF DY.Bytes).pack from rfl, DY.Bytes.rec_eq (gSym0 compI0) (gAll compI0 S g)]
    rfl
  rw [hγ, hk, ssCipherKey0_eq_compAesK0, hiv, ssIv0_take16_eq_compAesIv0, hm, CompI0Laws.compAesPerm_pt0]
  exact compAesCt0_untagged
theorem preNXOK_encOut_pt0 {S : Sem} {g : Ghost} (tr₂ : ExecTrace) {stA : DY.Libsignal.TripleRatchet.TRState} (cl pqIdx : Nat) (hst : TRStateNX S g stA) (hencPrk : (gamma compI0 S g (encPrk tr₂ stA cl pqIdx)).take 4 ≠ compTag4) (hsalt : PreNXOK S g (encSalt tr₂ stA cl pqIdx)) (hpt_eq : gamma compI0 S g (randTerm tr₂.length 32) = CompRX0SS38.ptB) (hpt_u : (gamma compI0 S g (randTerm tr₂.length 32)).take 4 ≠ compTag4) (hc_u : (gamma compI0 S g (randTerm (tr₂.length + 1) cl)).take 4 ≠ compTag4) (hseed : (gamma compI0 S g (DY.Libsignal.TripleRatchet.kdfCk stA.cks).2).take 4 ≠ compTag4) (hcipherKey : (gamma compI0 S g (encKeys tr₂ stA cl pqIdx).cipherKey).take 4 ≠ compTag4) (hmacKey : (gamma compI0 S g (encKeys tr₂ stA cl pqIdx).macKey).take 4 ≠ compTag4) (hiv : (gamma compI0 S g (encKeys tr₂ stA cl pqIdx).iv).take 4 ≠ compTag4) (hmacFull : (gamma compI0 S g (DY.Libsignal.TripleRatchet.hmac (encKeys tr₂ stA cl pqIdx).macKey (DY.Concat.concat stA.myIk (DY.Concat.concat stA.peerIk (encWire tr₂ stA cl pqIdx))))).take 4 ≠ compTag4) (hck_eq : gamma compI0 S g (encKeys tr₂ stA cl pqIdx).cipherKey = ssCipherKey0) (hiv_eq : gamma compI0 S g (encKeys tr₂ stA cl pqIdx).iv = ssIv0) : PreNXOK S g (encOut tr₂ stA cl pqIdx) := by dsimp only [encOut, encWire, encMac, DY.Libsignal.TripleRatchet.trHonestWireMsg]; have hmk := preNXOK_trMsgKeys hseed hencPrk hcipherKey hmacKey hiv hsalt hst.cks; have hct := preNXOK_symEnc (gamma_symEnc_untagged_of_compAesPt0 hck_eq hiv_eq (hpt_eq.trans ssPtBytes_eq_compAesPt0)) hmk.1 hmk.2.2 (preNXOK_randTerm hpt_u); have hdhsPk := preNXOK_dhPk hst.dhs; have hpqMsg := preNXOK_spqrSendMsg hst.spqr (preNXOK_randTerm hc_u); exact preNXOK_concat (preNXOK_trWire hdhsPk hct hpqMsg) (preNXOK_computeMac_trWire hmacFull hmk.2.1 hst.myIk hst.peerIk hdhsPk hct hpqMsg)
theorem preNXOK_setupSecrets_of_eq {w : PQXDHSpqrSetup} {r : Records} {S : Sem} {g : Ghost} (ha : w.aliceId = Witnesses.Cheval26WeakState.setup.aliceId) (hb : w.bobId = Witnesses.Cheval26WeakState.setup.bobId) (hs : w.spk = Witnesses.Cheval26WeakState.setup.spk) (hfits : compFitsPinned w compI0 r) (hc : Compat compI0 r S g) : PreNXOK S g (randTerm 0 32) ∧ PreNXOK S g (randTerm 5 32) ∧ PreNXOK S g (randTerm 10 32) ∧ PreNXOK S g (randTerm 16 64) := by
  have hNe : r.alice ≠ r.bob := hfits.1.1.1; refine ⟨preNXOK_randTerm ?_, preNXOK_randTerm ?_, preNXOK_randTerm ?_, preNXOK_randTerm ?_⟩
  · rw [← CompSetupSecrecy.setupSecret_0 hNe, CompRX0Bytes.gamma_setupSecret_0 hNe hc, hfits.1.2.2.2.2.2.2.1, ha]; exact ws_aliceId_untagged
  · rw [← CompSetupSecrecy.setupSecret_1 hNe, CompRX0Bytes.gamma_setupSecret_1 hNe hc, hfits.1.2.2.2.2.2.2.2.1, hb]; exact ws_bobId_untagged
  · rw [← CompSetupSecrecy.setupSecret_2 hNe, CompRX0Bytes.gamma_setupSecret_2 hNe hc, hfits.1.2.2.2.2.2.2.2.2.1, hs]; exact ws_spk_untagged
  · rw [← CompSetupSecrecy.setupSecret_4 hNe, gamma_setupSecret_4 hNe hc, (CompFitsNames.compFits_secretBytes_fresh hfits).2.1]; exact fillFresh_16_64_untagged
theorem preNXOK_storedSecrets_of_eq {w : PQXDHSpqrSetup} {r : Records} {S : Sem} {g : Ghost} {ms : List Move} (ha : w.aliceId = Witnesses.Cheval26WeakState.setup.aliceId) (hb : w.bobId = Witnesses.Cheval26WeakState.setup.bobId) (hs : w.spk = Witnesses.Cheval26WeakState.setup.spk) (hfits : compFitsPinned w compI0 r) (hc : Compat compI0 r S g) (hns : ∀ m ∈ ms, m.isSetup = false) (hreach : (runTraceMoves r ms).Reachable DY.Libsignal.Composed.reachability) : ∀ u ∈ storedSecrets (runTraceMoves r ms), PreNXOK S g u := by
  have hNe : r.alice ≠ r.bob := hfits.1.1.1; have hopk : r.withOpk = false := hfits.1.2.1; obtain ⟨h0, h5, h10, h16⟩ := preNXOK_setupSecrets_of_eq ha hb hs hfits hc; have hinv := CompInv.spqrInv_of_reachable (runTraceMoves r ms) hreach; intro u hu; obtain ⟨j, _, ⟨part, ⟨kind, sk⟩⟩, hat, rfl⟩ := mem_storedSecrets_iff.mp hu; refine preNXOK_serialize_local_pqxdh ?_; have hkind : CompInv.KindOK (runTraceMoves r ms) part ⟨kind, sk⟩ := hinv.stOK part ⟨kind, sk⟩ j hat; dsimp only [CompInv.KindOK] at hkind ⊢
  cases kind with
  | identity =>
    rcases CompSetupSecrecy.ikAt_cases_of_no_setup hNe hns hkind with ⟨_, rfl, _⟩ | ⟨_, rfl, _⟩
    · rw [CompSetupSecrecy.setupSecret_0 hNe]; exact h0
    · rw [CompSetupSecrecy.setupSecret_1 hNe]; exact h5
  | signedPrekey => obtain ⟨_, rfl, _⟩ := CompSetupSecrecy.spkAt_eq_of_no_setup hNe hns hkind; rw [CompSetupSecrecy.setupSecret_2 hNe]; exact h10
  | pqPrekey => obtain ⟨_, rfl, _⟩ := CompSetupSecrecy.pqAt_eq_of_no_setup hNe hns hkind; rw [CompSetupSecrecy.setupSecret_4 hNe]; exact h16
  | oneTimePrekey =>
    obtain ⟨t, rfl, _, hev⟩ := hkind
    rcases CompSetupSecrecy.setupTrace_eventLoggedAt_cases hNe (CompSetupSecrecy.noNewNonMovePQEv_runTrace r ms hns _ (t + 1) rfl hev) with
      ⟨_, heq⟩ | ⟨_, heq⟩ | ⟨_, heq⟩ | ⟨_, heq⟩ | ⟨hopk_true, _, _⟩ <;> [cases heq; cases heq; cases heq; cases heq; (rw [hopk] at hopk_true; cases hopk_true)]
theorem ssSeedPin (S : Sem) (g : Ghost) (tr₁ tr₂ : ExecTrace) (b : DY.Participant) (o : DY.Libsignal.PQXDH.AliceHandshakeOut) (cl : Nat) (hP : gamma compI0 S g (encPrk tr₂ (iniAliceStartState tr₁ b o) cl (tr₂.length + 2)) = sentPrk) : gamma compI0 S g (DY.Libsignal.TripleRatchet.kdfCk (iniAliceStartState tr₁ b o).cks).2 = ssSeed0 := by
  have hsL : (gamma compI0 S g (encSalt tr₂ (iniAliceStartState tr₁ b o) cl (tr₂.length + 2))).length = 32 := (by rw [encSalt_iniAliceStartState_eq_spqrChainKey]; exact CompRPreMemo38KdfCensus.gamma_spqrChainKey_length _ _ _)
  exact (CompRSplit38Untagged.gamma_hmac_eq_hmacWith S g (encSalt tr₂ (iniAliceStartState tr₁ b o) cl (tr₂.length + 2))
    (DY.Libsignal.TripleRatchet.kdfCk (iniAliceStartState tr₁ b o).cks).2 sentSalt ssSeed0 (by rw [hsL]; decide) (by decide)
    (by rw [sentPrk_eq]; exact sentPrk_untagged) (by rw [sentPrk_eq]; exact hP)).2
theorem split38_ss_kdf_eqs (S : Sem) (g : Ghost) (tr₁ tr₂ : ExecTrace) (b : DY.Participant) (ikA ikBPk spkPk pqPk : DY.Bytes) (cl : Nat) (hP : gamma compI0 S g (encPrk tr₂ (iniAliceStartState tr₁ b (iniAliceOut tr₁ ikA ikBPk spkPk pqPk none)) cl (tr₂.length + 2)) = sentPrk) (hk : gamma compI0 S g (encKeys tr₂ (iniAliceStartState tr₁ b (iniAliceOut tr₁ ikA ikBPk spkPk pqPk none)) cl (tr₂.length + 2)).macKey = sentMacKey) : let o := iniAliceOut tr₁ ikA ikBPk spkPk pqPk none;
    let ikm := iniAliceIkm tr₁ ikA ikBPk spkPk pqPk; let stA := iniAliceStartState tr₁ b o;
    gamma compI0 S g (pqxdhPrk ikm) = ssPqxdhPrk0 ∧ gamma compI0 S g (DY.Libsignal.PQXDH.pqxdhKdf ikm).rk = ssRk0 ∧ gamma compI0 S g (DY.Libsignal.PQXDH.pqxdhKdf ikm).ck = ssPqxdhCk0 ∧ gamma compI0 S g (DY.Libsignal.PQXDH.pqxdhKdf ikm).pqr = ssPqxdhPqr0 ∧ gamma compI0 S g (iniChainPrk tr₁ o) = ssChainPrk0 ∧ gamma compI0 S g stA.rk = ssStARk0 ∧ gamma compI0 S g stA.cks = ssCks0 ∧ gamma compI0 S g (DY.Libsignal.TripleRatchet.kdfCk stA.cks).1 = ssCks1 ∧ gamma compI0 S g (DY.Libsignal.TripleRatchet.kdfCk stA.cks).2 = ssSeed0 ∧ gamma compI0 S g (encKeys tr₂ stA cl (tr₂.length + 2)).cipherKey = ssCipherKey0 ∧
    gamma compI0 S g (encKeys tr₂ stA cl (tr₂.length + 2)).iv = ssIv0 := by
  let o := iniAliceOut tr₁ ikA ikBPk spkPk pqPk none; let ikm := iniAliceIkm tr₁ ikA ikBPk spkPk pqPk; let stA := iniAliceStartState tr₁ b o; have ho_keys : o.keys = DY.Libsignal.PQXDH.pqxdhKdf ikm := rfl; have hseed_eq := ssSeedPin S g tr₁ tr₂ b o cl hP; have hcks0_eq : gamma compI0 S g stA.cks = ssCks0 := (by have h := keyOfTake8_encSeed_ini S g tr₁ b o (by change (gamma compI0 S g (DY.Libsignal.TripleRatchet.kdfCk stA.cks).2).take 4 ≠ compTag4; rw [hseed_eq]; exact ssSeed0_untagged); change keyOfTake8 ((gamma compI0 S g (DY.Libsignal.TripleRatchet.kdfCk stA.cks).2).take 8) = some (gamma compI0 S g stA.cks) at h; rw [hseed_eq, keyOfTake8_ssSeed0] at h; exact (Option.some.inj h).symm); have hchainPrk_eq : gamma compI0 S g (iniChainPrk tr₁ o) = ssChainPrk0 := (by have h := keyOfTake8_ini_cks S g tr₁ b o (by rw [hcks0_eq]; exact ssCks0_untagged); rw [hcks0_eq, keyOfTake8_ssCks0] at h; exact (Option.some.inj h).symm); have hrk0_eq' : gamma compI0 S g o.keys.rk = ssRk0 := (by have h := keyOfTake8_iniChainPrk S g tr₁ o ikm ho_keys (by rw [hchainPrk_eq]; exact ssChainPrk0_untagged); rw [hchainPrk_eq, keyOfTake8_ssChainPrk0] at h; exact (Option.some.inj h).symm)
  have hrk0_eq : gamma compI0 S g (DY.Libsignal.PQXDH.pqxdhKdf ikm).rk = ssRk0 := by rw [← ho_keys]; exact hrk0_eq'
