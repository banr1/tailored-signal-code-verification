theorem kemEncap_fst_untagged_of_e0 {S : Sem} {g : Ghost} {pk e : DY.Bytes} (he : gamma compI0 S g e = compKyberE0) : (gamma compI0 S g (DY.PQKem.kemEncap pk e).1).take 4 ≠ compTag4 := by
