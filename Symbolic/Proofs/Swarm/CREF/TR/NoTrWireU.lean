/-- Ghost- and semantics-independent `NoTrWire` predicate. -/
def NoTrWireU (u : DY.Bytes) : Prop :=
  ∀ (i : ExternInterpretation) (S : OpaqueSymbolSemantics) (g : Ghost), NoTrWire i S g u

