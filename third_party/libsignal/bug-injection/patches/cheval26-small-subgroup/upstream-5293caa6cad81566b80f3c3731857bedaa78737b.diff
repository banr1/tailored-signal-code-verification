+            ))
+            .expect("structurally valid")
+            .scalar_is_in_range(),
+            "2^255 should be out of range"
+        );
+        assert!(
+            !PublicKey::from_djb_public_key_bytes(&[0xFF; 32])
+                .expect("structurally valid")
+                .scalar_is_in_range(),
+            "2^256 - 1 should be out of range"
+        );
+        {
