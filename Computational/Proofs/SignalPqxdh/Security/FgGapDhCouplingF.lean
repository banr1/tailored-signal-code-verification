def InSessions {S : Setup} (st : KeyIndState S) :
    (KeyIndInitiatorEntry S ⊕ KeyIndRespEntry S) → Prop
  | .inl s => s ∈ st.sessions
  | .inr r => r ∈ st.respSessions

def randRootKey {S : Setup} : (KeyIndInitiatorEntry S ⊕ KeyIndRespEntry S) → Bytes
  | .inl s => s.drKeyRand.rootKey
  | .inr r => r.drKeyRand.rootKey

/-- Connected-component relation on `(KeyIndInitiatorEntry S ⊕ KeyIndRespEntry S)` generated by
    `keyIndPartner P s r = true` across initiator and responder sessions in `st`. -/
inductive SamePartnerComp {S : Setup} (P : Primitives) (st : KeyIndState S) :
    (KeyIndInitiatorEntry S ⊕ KeyIndRespEntry S) → (KeyIndInitiatorEntry S ⊕ KeyIndRespEntry S) → Prop
  | refl (x) : SamePartnerComp P st x x
  | symm {x y} : SamePartnerComp P st x y → SamePartnerComp P st y x
  | trans {x y z} : SamePartnerComp P st x y → SamePartnerComp P st y z → SamePartnerComp P st x z
  | partner {s r} (hs : s ∈ st.sessions) (hr : r ∈ st.respSessions) (h : keyIndPartner P s r = true)
      :
      SamePartnerComp P st (.inl s) (.inr r)

def PartnerTarget {S : Setup} (P : Primitives) :
    (KeyIndInitiatorEntry S ⊕ KeyIndRespEntry S) → (KeyIndInitiatorEntry S ⊕ KeyIndRespEntry S) → Prop
  | .inl s1, .inl s2 => s1 = s2
  | .inr r1, .inr r2 => r1 = r2
  | .inl s,  .inr r  => keyIndPartner P s r = true
  | .inr r,  .inl s  => keyIndPartner P s r = true

theorem partnerTarget_refl {S : Setup} (P : Primitives)
    (x : KeyIndInitiatorEntry S ⊕ KeyIndRespEntry S) : PartnerTarget P x x := by
  cases x <;> rfl

theorem partnerTarget_symm {S : Setup} (P : Primitives)
    {x y : KeyIndInitiatorEntry S ⊕ KeyIndRespEntry S}
    (h : PartnerTarget P x y) : PartnerTarget P y x := by
  cases x <;> cases y <;> dsimp only [PartnerTarget] at h ⊢ <;> first | exact Eq.symm h | exact h

theorem partnerTarget_trans {S : Setup} (P : Primitives) (hst : KeyIndShCrState S)
    (hNoEc : hasEcPkCollisionKeyInd P hst.base = false)
    (hNoKem : hasKemPkCollisionKeyInd hst.base = false)
    (hRespBundleNodup : (hst.base.respSessions.map (fun r => (respBundleIdx r.sid,
      r.hdr.ekAPk))).Nodup)
    (hRespValid : ∀ r ∈ hst.base.respSessions, ValidRespSession S P hst r)
    {x y z : KeyIndInitiatorEntry S ⊕ KeyIndRespEntry S}
    (hx : InSessions hst.base x) (_hy : InSessions hst.base y) (hz : InSessions hst.base z)
    (hxy : PartnerTarget P x y) (hyz : PartnerTarget P y z) :
    PartnerTarget P x z := by
  rcases x with s1 | r1 <;> rcases y with s2 | r2 <;> rcases z with s3 | r3 <;>
    dsimp only [PartnerTarget, InSessions] at hx hz hxy hyz ⊢
  · exact Eq.trans hxy hyz
  · subst hxy; exact hyz
  · exact keyIndPartner_inj_left P hst.base hNoEc hx hz hxy hyz
  · subst hyz; exact hxy
  · subst hyz; exact hxy
  · exact keyIndPartner_inj_right P hst hNoKem hRespBundleNodup hx hz
      (hRespValid r1 hx) (hRespValid r3 hz) hxy hyz
  · subst hxy; exact hyz
  · exact Eq.trans hxy hyz

theorem SamePartnerComp.to_partnerTarget_aux {S : Setup} (P : Primitives) (hst : KeyIndShCrState S)
    (hNoEc : hasEcPkCollisionKeyInd P hst.base = false)
    (hNoKem : hasKemPkCollisionKeyInd hst.base = false)
    (hRespBundleNodup : (hst.base.respSessions.map (fun r => (respBundleIdx r.sid,
      r.hdr.ekAPk))).Nodup)
    (hRespValid : ∀ r ∈ hst.base.respSessions, ValidRespSession S P hst r)
    {x y : KeyIndInitiatorEntry S ⊕ KeyIndRespEntry S}
    (h : SamePartnerComp P hst.base x y) :
    x = y ∨ (InSessions hst.base x ∧ InSessions hst.base y ∧ PartnerTarget P x y) := by
  induction h with
  | refl x => exact Or.inl rfl
  | symm _ ih =>
    rcases ih with rfl | ⟨hx, hy, hT⟩
    · exact Or.inl rfl
    · exact Or.inr ⟨hy, hx, partnerTarget_symm P hT⟩
  | trans _ _ ih1 ih2 =>
    rcases ih1 with rfl | ⟨hx, hy, hT1⟩
    · exact ih2
    · rcases ih2 with rfl | ⟨_, hz, hT2⟩
      · exact Or.inr ⟨hx, hy, hT1⟩
      · exact Or.inr ⟨hx, hz, partnerTarget_trans P hst hNoEc hNoKem hRespBundleNodup hRespValid hx
          hy hz hT1 hT2⟩
  | partner hs hr hP =>
    exact Or.inr ⟨hs, hr, hP⟩

theorem SamePartnerComp.to_partnerTarget {S : Setup} (P : Primitives) (hst : KeyIndShCrState S)
    (hNoEc : hasEcPkCollisionKeyInd P hst.base = false)
    (hNoKem : hasKemPkCollisionKeyInd hst.base = false)
    (hRespBundleNodup : (hst.base.respSessions.map (fun r => (respBundleIdx r.sid,
      r.hdr.ekAPk))).Nodup)
    (hRespValid : ∀ r ∈ hst.base.respSessions, ValidRespSession S P hst r)
    {x y : KeyIndInitiatorEntry S ⊕ KeyIndRespEntry S}
    (h : SamePartnerComp P hst.base x y) :
    PartnerTarget P x y := by
  rcases SamePartnerComp.to_partnerTarget_aux P hst hNoEc hNoKem hRespBundleNodup hRespValid h with
    rfl | ⟨_, _, hT⟩
  · exact partnerTarget_refl P x
  · exact hT

/-- Invariant on `drKeyRand.rootKey` tags and session/responder `Nodup` properties in
    `pqxdhKeyIndAdvTagImpl`. -/
structure ValidLazyRand (S : Setup) (P : Primitives) (st : KeyIndState S) : Prop where
  sid_nodup : (st.sessions.map (·.sid)).Nodup
  resp_sid_nodup : (st.respSessions.map (·.sid)).Nodup
  resp_bundle_nodup : (st.respSessions.map (fun r => (respBundleIdx r.sid, r.hdr.ekAPk))).Nodup
  resp_kyber_mem : ∀ r ∈ st.respSessions, ∀ k j, respBundleIdx r.sid = some (k, j) →
    (k, UInt32.ofNat j, UInt32.ofNat j, r.hdr.ekAPk) ∈ st.seenKyberBaseKeys
  resp_used_opk : ∀ r ∈ st.respSessions, ∀ k j o, r.sid = .recvOPK k j o →
    (k.val, j.val, o.val) ∈ st.usedRecvOPK
  resp_used_no_opk : ∀ r ∈ st.respSessions, ∀ k j l, r.sid = .recvNoOPK k j l →
    (k.val, j.val, l.val) ∈ st.usedRecvNoOPK
  init_rand_lt : ∀ s ∈ st.sessions, s.drKeyRand.rootKey.length < st.sessions.length +
    st.respSessions.length
  resp_rand_lt : ∀ r ∈ st.respSessions, r.drKeyRand.rootKey.length < st.sessions.length +
    st.respSessions.length
  rand_comp : ∀ x y, InSessions st x → InSessions st y →
    randRootKey x = randRootKey y → SamePartnerComp P st x y
  partner_rand : ∀ s ∈ st.sessions, ∀ r ∈ st.respSessions, keyIndPartner P s r = true →
    (∃ r0 ∈ st.respSessions, keyIndPartner P s r0 = true ∧ s.drKeyRand.rootKey =
      r0.drKeyRand.rootKey) ∨
    (∃ s0 ∈ st.sessions, keyIndPartner P s0 r = true ∧ r.drKeyRand.rootKey = s0.drKeyRand.rootKey)

theorem init_eq_of_drKeyRand_eq {S : Setup} (P : Primitives) (hst : KeyIndShCrState S)
    (hRand : ValidLazyRand S P hst.base)
    (hNoEc : hasEcPkCollisionKeyInd P hst.base = false)
    (hNoKem : hasKemPkCollisionKeyInd hst.base = false)
    (hRespValid : ∀ r ∈ hst.base.respSessions, ValidRespSession S P hst r)
    {s1 s2 : KeyIndInitiatorEntry S} (hs1 : s1 ∈ hst.base.sessions) (hs2 : s2 ∈ hst.base.sessions)
    (hEq : s1.drKeyRand.rootKey = s2.drKeyRand.rootKey) :
    s1 = s2 :=
  SamePartnerComp.to_partnerTarget P hst hNoEc hNoKem hRand.resp_bundle_nodup hRespValid
    (hRand.rand_comp (.inl s1) (.inl s2) hs1 hs2 hEq)

theorem keyIndPartner_of_drKeyRand_eq {S : Setup} (P : Primitives) (hst : KeyIndShCrState S)
    (hRand : ValidLazyRand S P hst.base)
    (hNoEc : hasEcPkCollisionKeyInd P hst.base = false)
    (hNoKem : hasKemPkCollisionKeyInd hst.base = false)
    (hRespValid : ∀ r ∈ hst.base.respSessions, ValidRespSession S P hst r)
    {s : KeyIndInitiatorEntry S} {r : KeyIndRespEntry S}
    (hs : s ∈ hst.base.sessions) (hr : r ∈ hst.base.respSessions)
    (hEq : s.drKeyRand.rootKey = r.drKeyRand.rootKey) :
    keyIndPartner P s r = true :=
  SamePartnerComp.to_partnerTarget P hst hNoEc hNoKem hRand.resp_bundle_nodup hRespValid
    (hRand.rand_comp (.inl s) (.inr r) hs hr hEq)

theorem resp_eq_of_drKeyRand_eq {S : Setup} (P : Primitives) (hst : KeyIndShCrState S)
    (hRand : ValidLazyRand S P hst.base)
    (hNoEc : hasEcPkCollisionKeyInd P hst.base = false)
    (hNoKem : hasKemPkCollisionKeyInd hst.base = false)
    (hRespValid : ∀ r ∈ hst.base.respSessions, ValidRespSession S P hst r)
    {r1 r2 : KeyIndRespEntry S} (hr1 : r1 ∈ hst.base.respSessions) (hr2 : r2 ∈
      hst.base.respSessions)
    (hEq : r1.drKeyRand.rootKey = r2.drKeyRand.rootKey) :
    r1 = r2 :=
  SamePartnerComp.to_partnerTarget P hst hNoEc hNoKem hRand.resp_bundle_nodup hRespValid
    (hRand.rand_comp (.inr r1) (.inr r2) hr1 hr2 hEq)

theorem keyIndPartner_imp_drKeyRand_eq {S : Setup} (P : Primitives) (hst : KeyIndShCrState S)
    (hRand : ValidLazyRand S P hst.base)
    (hNoEc : hasEcPkCollisionKeyInd P hst.base = false)
    (hNoKem : hasKemPkCollisionKeyInd hst.base = false)
    (hRespValid : ∀ r ∈ hst.base.respSessions, ValidRespSession S P hst r)
    {s : KeyIndInitiatorEntry S} {r : KeyIndRespEntry S}
    (hs : s ∈ hst.base.sessions) (hr : r ∈ hst.base.respSessions)
    (hPart : keyIndPartner P s r = true) :
    s.drKeyRand.rootKey = r.drKeyRand.rootKey := by
  rcases hRand.partner_rand s hs r hr hPart with
    ⟨r0, hr0, hP0, hEq0⟩ | ⟨s0, hs0, hP0, hEq0⟩
  · have hrEq : r0 = r :=
      keyIndPartner_inj_right P hst hNoKem hRand.resp_bundle_nodup hr0 hr
        (hRespValid r0 hr0) (hRespValid r hr) hP0 hPart
    subst hrEq
    exact hEq0
  · have hsEq : s = s0 :=
      keyIndPartner_inj_left P hst.base hNoEc hs hs0 hPart hP0
    subst hsEq
    exact hEq0.symm

theorem init_eq_of_drKeyReal_eq {S : Setup} (P : Primitives)
    (hP : CryptoWellFormedPrimitivesδ P) (hst : KeyIndShCrState S)
    (hNoEc : hasEcPkCollisionKeyInd P hst.base = false)
    {s1 s2 : KeyIndInitiatorEntry S}
    (hs1Mem : s1 ∈ hst.base.sessions) (hs2Mem : s2 ∈ hst.base.sessions)
    (hs1 : ValidInitSession S P hst s1) (hs2 : ValidInitSession S P hst s2)
    (hKeyEq : s1.drKeyReal.rootKey = s2.drKeyReal.rootKey) :
    s1 = s2 := by
  have hw := hP.toWellFormedPrimitivesδ
  rcases hs1 with ⟨_, _, _, _, _, _, _, _, _, _, _,
    _, _, _, ss1, _, _, _, hEnc1, _, _, _, _, _, _, hKey1⟩
  rcases hs2 with ⟨_, _, _, _, _, _, _, _, _, _, _,
    _, _, _, ss2, _, _, _, hEnc2, _, _, _, _, _, _, hKey2⟩
  have hSs1Len : ss1.length = 32 := (hw.kemEncaps_len s1.peerPqspkPk _ ss1 s1.hdr.kemCt hEnc1).1
  have hSs2Len : ss2.length = 32 := (hw.kemEncaps_len s2.peerPqspkPk _ ss2 s2.hdr.kemCt hEnc2).1
  rw [hKey1, hKey2] at hKeyEq
  have hDh2Eq : P.x25519 s1.ekASk s1.peerIkPk = P.x25519 s2.ekASk s2.peerIkPk :=
    ((buildSecrets_eq_iff_of_len32
      (hw.x25519_len _ _) (hw.x25519_len _ _) (hw.x25519_len _ _)
      (by cases s1.peerOpkPk? <;> simp [hw.x25519_len]) hSs1Len
      (hw.x25519_len _ _) (hw.x25519_len _ _) (hw.x25519_len _ _)
      (by cases s2.peerOpkPk? <;> simp [hw.x25519_len]) hSs2Len).mp hKeyEq).2.2.1
  have hNodupDh2 : (hst.base.sessions.map (fun s => P.x25519 s.ekASk s.peerIkPk)).Nodup :=
    nodup_of_hasDuplicateBytes_eq_false (allInitDh2sKeyInd P hst.base) (Bool.or_eq_false_iff.mp
      hNoEc).2
  exact eq_of_nodup_map (fun s => P.x25519 s.ekASk s.peerIkPk) hNodupDh2 hs1Mem hs2Mem hDh2Eq

theorem find?_eq_some_of_nodup_map {α β : Type} [BEq β] [LawfulBEq β]
    (f : α → β) {L : List α} (hNodup : (L.map f).Nodup) {x : α} (hx : x ∈ L) :
    L.find? (fun y => f y == f x) = some x := by
  have hSome : (L.find? (fun y => f y == f x)).isSome = true :=
    List.find?_isSome.mpr ⟨x, hx, by simp⟩
  rcases Option.isSome_iff_exists.mp hSome with ⟨y, hy⟩
  rw [hy, Option.some.injEq]
  have hfy : (f y == f x) = true := List.find?_some (p := fun y => f y == f x) hy
  exact eq_of_nodup_map f hNodup (List.mem_of_find?_eq_some hy) hx (beq_iff_eq.mp hfy)

theorem nodup_map_of_inj_on {α β γ : Type} (f : α → β) (g : β → γ) {L : List α}
    (hNodup : (L.map f).Nodup)
    (hInj : ∀ x ∈ L, ∀ y ∈ L, g (f x) = g (f y) → f x = f y) :
    (L.map (fun x => g (f x))).Nodup := by
  induction L with
  | nil => simp
  | cons a tl ih =>
    simp only [List.map_cons, List.nodup_cons, List.mem_map] at hNodup ⊢
    refine ⟨?_, ih hNodup.2 (fun x hx y hy => hInj x (List.mem_cons_of_mem a hx) y
      (List.mem_cons_of_mem a hy))⟩
    rintro ⟨x, hx, hEq⟩
    exact hNodup.1 ⟨x, hx, hInj x (List.mem_cons_of_mem a hx) a List.mem_cons_self hEq⟩

theorem length_le_of_nodup_map_lt {α : Type} (f : α → Nat) (N : Nat) {L : List α}
    (hNodup : (L.map f).Nodup) (hLt : ∀ x ∈ L, f x < N) :
    L.length ≤ N := by
  have hsub : (L.map f).Subperm (List.range N) :=
    hNodup.subperm (fun y hy => by
      rw [List.mem_map] at hy
      rcases hy with ⟨x, hx, rfl⟩
      exact List.mem_range.mpr (hLt x hx))
  simpa using hsub.length_le

theorem fin_pair_flat_lt {N M : Nat} (u : Fin N) (i : Fin M) :
    u.val * M + i.val < N * M := by
  calc u.val * M + i.val
      < u.val * M + M := Nat.add_lt_add_left i.isLt _
    _ = (u.val + 1) * M := by ring
    _ ≤ N * M := Nat.mul_le_mul_right _ u.isLt

theorem nat_pair_flat_inj {M u1 u2 i1 i2 : Nat} (hi1 : i1 < M) (hi2 : i2 < M)
    (h : u1 * M + i1 = u2 * M + i2) : u1 = u2 ∧ i1 = i2 := by
  have hpos : 0 < M := Nat.zero_lt_of_lt hi1
  have hu : u1 = u2 := by
    have h1 : (u1 * M + i1) / M = u1 := by
      rw [Nat.mul_comm, Nat.mul_add_div hpos, Nat.div_eq_of_lt hi1, Nat.add_zero]
    have h2 : (u2 * M + i2) / M = u2 := by
      rw [Nat.mul_comm, Nat.mul_add_div hpos, Nat.div_eq_of_lt hi2, Nat.add_zero]
    rw [← h1, ← h2, h]
  exact ⟨hu, by rw [hu] at h; omega⟩

def sessionSlotIdx {S : Setup} : SessionId S → Nat
  | .sendOPK u i => u.val * S.N_send_opk + i.val
  | .sendNoOPK u i => S.N_send_opk_tot + (u.val * S.N_send_no_opk + i.val)
  | .recvOPK k j o => S.N_send_tot + ((k.val * S.N_recv + j.val) * S.N_opk + o.val)
  | .recvNoOPK k j l => S.N_send_tot + S.N_opk_tot + ((k.val * S.N_recv + j.val) * S.N_no_opk +
      l.val)

theorem sessionSlotIdx_lt {S : Setup} (sid : SessionId S) :
    sessionSlotIdx sid < S.N_sess_tot := by
  unfold Setup.N_sess_tot Setup.N_send_tot Setup.N_recv_tot Setup.N_send_opk_tot
    Setup.N_send_no_opk_tot
    Setup.N_opk_tot Setup.N_no_opk_tot Setup.N_spk_tot
  cases sid with
  | sendOPK u i =>
    have h := fin_pair_flat_lt u i
    simp only [sessionSlotIdx]; omega
  | sendNoOPK u i =>
    have h := fin_pair_flat_lt u i
    simp only [sessionSlotIdx, Setup.N_send_opk_tot]; omega
  | recvOPK k j o =>
    have hkj := fin_pair_flat_lt k j
    have hkjo := fin_pair_flat_lt ⟨k.val * S.N_recv + j.val, hkj⟩ o
    simp only [sessionSlotIdx, Setup.N_send_tot, Setup.N_send_opk_tot, Setup.N_send_no_opk_tot]
      at hkjo ⊢
    omega
  | recvNoOPK k j l =>
    have hkj := fin_pair_flat_lt k j
    have hkjl := fin_pair_flat_lt ⟨k.val * S.N_recv + j.val, hkj⟩ l
    simp only [sessionSlotIdx, Setup.N_send_tot, Setup.N_send_opk_tot, Setup.N_send_no_opk_tot,
      Setup.N_opk_tot, Setup.N_spk_tot] at hkjl ⊢
    omega

theorem sessionSlotIdx_inj {S : Setup} {sid1 sid2 : SessionId S}
    (h : sessionSlotIdx sid1 = sessionSlotIdx sid2) : sid1 = sid2 := by
  cases sid1 with
  | sendOPK u1 i1 =>
    have h1 := fin_pair_flat_lt u1 i1
    cases sid2 with
    | sendOPK u2 i2 =>
      rcases nat_pair_flat_inj i1.isLt i2.isLt h with ⟨hu, hi⟩
      rw [Fin.ext hu, Fin.ext hi]
    | sendNoOPK u2 i2 =>
      simp only [sessionSlotIdx, Setup.N_send_opk_tot] at h; omega
    | recvOPK k2 j2 o2 =>
      simp only [sessionSlotIdx, Setup.N_send_tot, Setup.N_send_opk_tot] at h; omega
    | recvNoOPK k2 j2 l2 =>
      simp only [sessionSlotIdx, Setup.N_send_tot, Setup.N_send_opk_tot] at h; omega
  | sendNoOPK u1 i1 =>
    have h1 := fin_pair_flat_lt u1 i1
    cases sid2 with
    | sendOPK u2 i2 =>
      have h2 := fin_pair_flat_lt u2 i2
      simp only [sessionSlotIdx, Setup.N_send_opk_tot] at h; omega
    | sendNoOPK u2 i2 =>
      simp only [sessionSlotIdx] at h
      rcases nat_pair_flat_inj i1.isLt i2.isLt (Nat.add_left_cancel h) with ⟨hu, hi⟩
      rw [Fin.ext hu, Fin.ext hi]
    | recvOPK k2 j2 o2 =>
      simp only [sessionSlotIdx, Setup.N_send_tot, Setup.N_send_opk_tot, Setup.N_send_no_opk_tot]
        at h; omega
    | recvNoOPK k2 j2 l2 =>
      simp only [sessionSlotIdx, Setup.N_send_tot, Setup.N_send_opk_tot, Setup.N_send_no_opk_tot]
        at h; omega
  | recvOPK k1 j1 o1 =>
    have hkj1 := fin_pair_flat_lt k1 j1
    have h1 := fin_pair_flat_lt ⟨k1.val * S.N_recv + j1.val, hkj1⟩ o1
    cases sid2 with
    | sendOPK u2 i2 =>
      have h2 := fin_pair_flat_lt u2 i2
      simp only [sessionSlotIdx, Setup.N_send_tot, Setup.N_send_opk_tot] at h; omega
    | sendNoOPK u2 i2 =>
      have h2 := fin_pair_flat_lt u2 i2
      simp only [sessionSlotIdx, Setup.N_send_tot, Setup.N_send_opk_tot, Setup.N_send_no_opk_tot]
        at h; omega
    | recvOPK k2 j2 o2 =>
      simp only [sessionSlotIdx] at h
      rcases nat_pair_flat_inj o1.isLt o2.isLt (Nat.add_left_cancel h) with ⟨hkj, ho⟩
      rcases nat_pair_flat_inj j1.isLt j2.isLt hkj with ⟨hk, hj⟩
      rw [Fin.ext hk, Fin.ext hj, Fin.ext ho]
    | recvNoOPK k2 j2 l2 =>
      simp only [sessionSlotIdx, Setup.N_opk_tot, Setup.N_spk_tot] at h h1; omega
  | recvNoOPK k1 j1 l1 =>
    have hkj1 := fin_pair_flat_lt k1 j1
    have h1 := fin_pair_flat_lt ⟨k1.val * S.N_recv + j1.val, hkj1⟩ l1
    cases sid2 with
    | sendOPK u2 i2 =>
      have h2 := fin_pair_flat_lt u2 i2
      simp only [sessionSlotIdx, Setup.N_send_tot, Setup.N_send_opk_tot] at h; omega
    | sendNoOPK u2 i2 =>
      have h2 := fin_pair_flat_lt u2 i2
      simp only [sessionSlotIdx, Setup.N_send_tot, Setup.N_send_opk_tot, Setup.N_send_no_opk_tot]
        at h; omega
    | recvOPK k2 j2 o2 =>
      have hkj2 := fin_pair_flat_lt k2 j2
      have h2 := fin_pair_flat_lt ⟨k2.val * S.N_recv + j2.val, hkj2⟩ o2
      simp only [sessionSlotIdx, Setup.N_opk_tot, Setup.N_spk_tot] at h h2; omega
    | recvNoOPK k2 j2 l2 =>
      simp only [sessionSlotIdx] at h
      have h2 : (k1.val * S.N_recv + j1.val) * S.N_no_opk + l1.val =
          (k2.val * S.N_recv + j2.val) * S.N_no_opk + l2.val := by omega
      rcases nat_pair_flat_inj l1.isLt l2.isLt h2 with ⟨hkj, hl⟩
      rcases nat_pair_flat_inj j1.isLt j2.isLt hkj with ⟨hk, hj⟩
      rw [Fin.ext hk, Fin.ext hj, Fin.ext hl]

theorem spkBundles_nodup_flatIdx {S : Setup} {spkBundles : List ((Nat × Nat) × SpkBundleEntry)}
    (hValSpk : ValidSpkBundles S spkBundles) :
    (spkBundles.map (fun kv => _root_.Proofs.SignalPqxdh.Security.FgGapDh.spkBundleFlatIdxVal S
      kv.1)).Nodup := by
  have h0 := nodup_map_of_inj_on (fun (e : (Nat × Nat) × SpkBundleEntry) => ecSpkSlotIdx S e.1)
    (fun n => n - S.N_id) hValSpk.2 (by
      intro x _ y _ hEq
      unfold ecSpkSlotIdx at hEq ⊢
      omega)
  simpa [ecSpkSlotIdx, spkSlotFlatIdx,
    _root_.Proofs.SignalPqxdh.Security.FgGapDh.spkBundleFlatIdxVal] using h0

theorem spkBundles_nodup_fst {S : Setup} {spkBundles : List ((Nat × Nat) × SpkBundleEntry)}
    (hValSpk : ValidSpkBundles S spkBundles) :
    (spkBundles.map Prod.fst).Nodup := by
  have h := spkBundles_nodup_flatIdx hValSpk
  rw [show spkBundles.map (fun kv => _root_.Proofs.SignalPqxdh.Security.FgGapDh.spkBundleFlatIdxVal
    S kv.1) =
    (spkBundles.map Prod.fst).map (_root_.Proofs.SignalPqxdh.Security.FgGapDh.spkBundleFlatIdxVal S)
      by
      simp [List.map_map, Function.comp_def]] at h
  exact List.Nodup.of_map _ h

theorem spkBundleFlatIdxVal_lt {S : Setup} {kj : Nat × Nat} (h : kj.1 < S.N_id ∧ kj.2 < S.N_recv) :
    _root_.Proofs.SignalPqxdh.Security.FgGapDh.spkBundleFlatIdxVal S kj < S.N_spk_tot := by
  have hlt := fin_pair_flat_lt ⟨kj.1, h.1⟩ ⟨kj.2, h.2⟩
  simpa [_root_.Proofs.SignalPqxdh.Security.FgGapDh.spkBundleFlatIdxVal, Setup.N_spk_tot] using hlt

theorem sessions_nodup_slotIdx {S : Setup} {sessions : List (KeyIndInitiatorEntry S)}
    (hSidNodup : (sessions.map KeyIndInitiatorEntry.sid).Nodup)
    (hSlotLt : ∀ s ∈ sessions, initSessionSlotIdx s.sid < S.N_send_tot) :
    (sessions.map (fun s => initSessionSlotIdx s.sid)).Nodup := by
  refine nodup_map_of_inj_on KeyIndInitiatorEntry.sid initSessionSlotIdx hSidNodup ?_
  intro x _ y hy hEq
  exact initSessionSlotIdx_inj_of_lt hEq (hSlotLt y hy)

theorem spkBundles_length_le_N_dh {S : Setup} {spkBundles : List ((Nat × Nat) × SpkBundleEntry)}
    (hValSpk : ValidSpkBundles S spkBundles) :
    spkBundles.length ≤ S.N_dh := by
  have hLe : spkBundles.length ≤ S.N_spk_tot :=
    length_le_of_nodup_map_lt
      (fun kv => _root_.Proofs.SignalPqxdh.Security.FgGapDh.spkBundleFlatIdxVal S kv.1)
      S.N_spk_tot (spkBundles_nodup_flatIdx hValSpk)
      (fun kv hkv => spkBundleFlatIdxVal_lt (hValSpk.1 kv hkv))
  unfold Setup.N_dh
  omega

theorem sessions_length_le_N_dh {S : Setup} {sessions : List (KeyIndInitiatorEntry S)}
    (hSidNodup : (sessions.map KeyIndInitiatorEntry.sid).Nodup)
    (hSlotLt : ∀ s ∈ sessions, initSessionSlotIdx s.sid < S.N_send_tot) :
    sessions.length ≤ S.N_dh := by
  have hLe : sessions.length ≤ S.N_send_tot :=
    length_le_of_nodup_map_lt (fun s => initSessionSlotIdx s.sid) S.N_send_tot
      (sessions_nodup_slotIdx hSidNodup hSlotLt) hSlotLt
  unfold Setup.N_dh
  omega

theorem respSessions_length_le_N_sess_tot {S : Setup} {respSessions : List (KeyIndRespEntry S)}
    (hSidNodup : (respSessions.map KeyIndRespEntry.sid).Nodup) :
    respSessions.length ≤ S.N_sess_tot := by
  refine length_le_of_nodup_map_lt (fun r => sessionSlotIdx r.sid) S.N_sess_tot ?_
    (fun r _ => sessionSlotIdx_lt r.sid)
  refine nodup_map_of_inj_on KeyIndRespEntry.sid sessionSlotIdx hSidNodup ?_
  intro x _ y _ hEq
  exact sessionSlotIdx_inj hEq

theorem respBundleKey_eq_of_respBundleIdx {S : Setup} {sid : SessionId S} {kj : Nat × Nat}
    (h : respBundleIdx sid = some kj) :
    respBundleKey sid = kj := by
  cases sid <;> simp [respBundleIdx, respBundleKey] at h ⊢ <;> exact h

theorem not_revealed_of_not_isSpkRevealed (P : Primitives)
    (spkBundles : List ((Nat × Nat) × SpkBundleEntry))
    {kj : Nat × Nat} {bEntry : SpkBundleEntry} {pk : Bytes}
    (hbMem : (kj, bEntry) ∈ spkBundles)
    (hPow : P.pow8 pk = P.pow8 bEntry.spkPk)
    (hNotRev : (!isSpkRevealed P spkBundles pk) = true) :
    (!bEntry.revealed) = true := by
  cases hRev : bEntry.revealed with
  | false => rfl
  | true =>
    exfalso
    have hIsRev : isSpkRevealed P spkBundles pk = true := by
      unfold isSpkRevealed
      rw [List.any_eq_true]
      exact ⟨(kj, bEntry), hbMem, by simp [hRev, hPow]⟩
    rw [hIsRev] at hNotRev
    nomatch hNotRev

theorem opkEntries_nodup_slotIdx {S : Setup} {opkEntries : List ((Nat × Nat × Nat) × OpkEntry)}
    (hVal : ValidOpkEntries S opkEntries) :
    (opkEntries.map (fun kv => opkSlotFlatIdx S kv.1)).Nodup := by
  have hNodup := hVal.2
  have hEq : opkEntries.map (fun e => ecOpkSlotIdx S e.1) =
      (opkEntries.map (fun kv => opkSlotFlatIdx S kv.1)).map (fun n => S.N_id + S.N_spk_tot + n) :=
        by
    rw [List.map_map]; rfl
  rw [hEq] at hNodup
  exact List.Nodup.of_map _ hNodup

theorem badKeyIndFgAny_of_init_mem_advRoLog {S : Setup} (P : Primitives)
    (hP : CryptoWellFormedPrimitivesδ P) (maxLen : ℕ)
    (hst : KeyIndShCrState S) (advRoLog : List Bytes)
    (hKS : ValidKeyStores S P hst.base)
    (hSidNodup : (hst.base.sessions.map KeyIndInitiatorEntry.sid).Nodup)
    (hSessValid : ∀ s ∈ hst.base.sessions, ValidInitSession S P hst s)
    {s : KeyIndInitiatorEntry S} (hsMem : s ∈ hst.base.sessions)
    (hFresh : s.fresh = true) (hSpkHon : s.spkHonest = true)
    (hNotRev : (!isSpkRevealed P hst.base.spkBundles s.peerSpkPk) = true)
    (hRoMem : s.drKeyReal.rootKey ∈ advRoLog.take maxLen) :
    badKeyIndFgAny P maxLen hst.base advRoLog = true := by
  have hw := hP.toWellFormedPrimitivesδ
  have hs := hSessValid s hsMem
  rcases hKS with ⟨_, hValSpk, _, _, hSpks, _, _⟩
  rcases hs with ⟨hSlotLt, _, _, _, _, hSpkHonImp, _, _, _, _, _,
    u, uEntry, kemCoins, ss, initRec, _, _, hEnc, _, _, _, _, _, _, hsKey⟩
  rcases hSpkHonImp hSpkHon with ⟨k, j, bEntry, hbMem, hPowSpk⟩
  have hbNotRev : (!bEntry.revealed) = true :=
    not_revealed_of_not_isSpkRevealed P hst.base.spkBundles hbMem hPowSpk.symm hNotRev
  have hFindS : hst.base.sessions.find? (fun s' => initSessionSlotIdx s'.sid == initSessionSlotIdx
    s.sid) = some s :=
    find?_eq_some_of_nodup_map (fun s' => initSessionSlotIdx s'.sid)
      (sessions_nodup_slotIdx hSidNodup (fun s' hs' => (hSessValid s' hs').1)) hsMem
  let bIdx := _root_.Proofs.SignalPqxdh.Security.FgGapDh.spkBundleFlatIdxVal S (k, j)
  have hbIdxLt : bIdx < S.N_spk_tot := spkBundleFlatIdxVal_lt (hValSpk.1 ((k, j), bEntry) hbMem)
  have hFindB : hst.base.spkBundles.find?
      (fun (k', _) => _root_.Proofs.SignalPqxdh.Security.FgGapDh.spkBundleFlatIdxVal S k' == bIdx) =
      some ((k, j), bEntry) :=
    find?_eq_some_of_nodup_map
      (fun kv => _root_.Proofs.SignalPqxdh.Security.FgGapDh.spkBundleFlatIdxVal S kv.1)
      (spkBundles_nodup_flatIdx hValSpk) hbMem
  have hbSpkPk : bEntry.spkPk = P.x25519Base bEntry.spkSk :=
    (hSpks ((k, j), bEntry) hbMem).2.1
  have hPowSpkBase : P.pow8 s.peerSpkPk = P.pow8 (P.x25519Base bEntry.spkSk) := by
    rw [← hPowSpk, hbSpkPk]
  have hDh3 : extractDh3 s.drKeyReal.rootKey = P.x25519 s.ekASk bEntry.spkPk := by
    rw [hsKey, extractDh3_buildSecrets (hw.x25519_len _ _) (hw.x25519_len _ _) (hw.x25519_len _ _),
        hbSpkPk]
    exact hP.x25519_pow8_congr s.ekASk s.peerSpkPk (P.x25519Base bEntry.spkSk)
      (hP.pow8_base_len s.peerSpkPk bEntry.spkSk hPowSpkBase)
      (hw.x25519Base_len bEntry.spkSk) hPowSpkBase
  have hAt : badKeyIndFgDh3At P maxLen (initSessionSlotIdx s.sid) bIdx hst.base advRoLog = true :=
    by
    unfold badKeyIndFgDh3At
    rw [hFindS, hFindB]
    simp only [Bool.and_eq_true, beq_iff_eq, List.any_eq_true]
    exact ⟨⟨⟨⟨hFresh, hSpkHon⟩, hbNotRev⟩, hPowSpk.symm⟩, s.drKeyReal.rootKey, hRoMem, hDh3⟩
  unfold badKeyIndFgAny
  simp only [Bool.or_eq_true, List.any_eq_true, List.mem_range]
  exact Or.inr ⟨initSessionSlotIdx s.sid, hSlotLt, bIdx, hbIdxLt, hAt⟩

theorem exists_uncorrupted_of_isHonestUncorruptedPeer_isSome {S : Setup} (P : Primitives)
    (st : KeyIndState S) (hValPrin : ValidPrincipals S st.principals)
    {ikPk : Bytes} (hPeer : (isHonestUncorruptedPeer P st.principals ikPk).isSome = true) :
    ∃ u uEntry,
      u < S.N_id ∧
      (u, uEntry) ∈ st.principals ∧
      st.principals.find? (fun (u', _) => u' == u) = some (u, uEntry) ∧
      uEntry.corrupted = false ∧
      P.pow8 ikPk = P.pow8 uEntry.ikAPk := by
  unfold isHonestUncorruptedPeer findHonestPrincipal at hPeer
  cases hF : st.principals.find? (fun (_, entry) => P.pow8 ikPk == P.pow8 entry.ikAPk) with
  | none => rw [hF] at hPeer; nomatch hPeer
  | some p =>
    rcases p with ⟨u, uEntry⟩
    rw [hF] at hPeer
    dsimp only at hPeer
    cases hCorr : uEntry.corrupted with
    | true => rw [hCorr] at hPeer; nomatch hPeer
    | false =>
      have hMem : (u, uEntry) ∈ st.principals := List.mem_of_find?_eq_some hF
      have hPow : (P.pow8 ikPk == P.pow8 uEntry.ikAPk) = true :=
        List.find?_some (p := fun (x : Nat × PrincipalEntry) => P.pow8 ikPk == P.pow8 x.2.ikAPk) hF
      exact ⟨u, uEntry, hValPrin.1 (u, uEntry) hMem, hMem,
        find?_eq_some_of_nodup_map Prod.fst hValPrin.2 hMem,
        hCorr, beq_iff_eq.mp hPow⟩

theorem badKeyIndFgAny_of_resp_mem_advRoLog {S : Setup} (P : Primitives)
    (hP : CryptoWellFormedPrimitivesδ P) (maxLen : ℕ)
    (hst : KeyIndShCrState S) (advRoLog : List Bytes)
    (hKS : ValidKeyStores S P hst.base)
    {r : KeyIndRespEntry S} (hr : ValidRespSession S P hst r)
    (hPeer : (isHonestUncorruptedPeer P hst.base.principals r.hdr.ikAPk).isSome = true)
    (hNotRev : (!isSpkRevealed P hst.base.spkBundles r.spkPk) = true)
    (hRoMem : r.drKeyReal.rootKey ∈ advRoLog.take maxLen) :
    badKeyIndFgAny P maxLen hst.base advRoLog = true := by
  have hw := hP.toWellFormedPrimitivesδ
  rcases hKS with ⟨hValPrin, hValSpk, _, hPrins, hSpks, _, _⟩
  rcases exists_uncorrupted_of_isHonestUncorruptedPeer_isSome P hst.base hValPrin hPeer with
    ⟨u, uEntry, huLt, huMem, hFindP, huCorr, hPowIkA⟩
  rcases hr with ⟨k, j, _, bEntry, ss, _, _, _, hbMem, _,
    _, hrSpk, _, _, _, _, _, _, _, _, _, _, _, _, _, _, hrOpkCases⟩
  have hbNotRev : (!bEntry.revealed) = true :=
    not_revealed_of_not_isSpkRevealed P hst.base.spkBundles hbMem (congrArg P.pow8 hrSpk) hNotRev
  have huIk := hPrins (u, uEntry) huMem
  have hbSpk := hSpks ((k.val, j.val), bEntry) hbMem
  let bIdx := _root_.Proofs.SignalPqxdh.Security.FgGapDh.spkBundleFlatIdxVal S (k.val, j.val)
  have hbIdxLt : bIdx < S.N_spk_tot := spkBundleFlatIdxVal_lt ⟨k.isLt, j.isLt⟩
  have hFindB : hst.base.spkBundles.find?
      (fun (k', _) => _root_.Proofs.SignalPqxdh.Security.FgGapDh.spkBundleFlatIdxVal S k' == bIdx) =
      some ((k.val, j.val), bEntry) :=
    find?_eq_some_of_nodup_map
      (fun kv => _root_.Proofs.SignalPqxdh.Security.FgGapDh.spkBundleFlatIdxVal S kv.1)
      (spkBundles_nodup_flatIdx hValSpk) hbMem
  have hDh1Comm : P.x25519 bEntry.spkSk r.hdr.ikAPk = P.x25519 uEntry.secIKA0 bEntry.spkPk := by
    have hPowBase : P.pow8 r.hdr.ikAPk = P.pow8 (P.x25519Base uEntry.secIKA0) := by
      rw [hPowIkA, huIk.2]
    rw [x25519_comm_of_pow8_eq P hP bEntry.spkSk uEntry.secIKA0 r.hdr.ikAPk hPowBase, ← hbSpk.2.1]
  have hDh1 : extractDh1 r.drKeyReal.rootKey = P.x25519 uEntry.secIKA0 bEntry.spkPk := by
    rcases hrOpkCases with ⟨_, _, hrKey⟩ | ⟨_, _, _, _, _, hrKey⟩ <;> {
      rw [hrKey, extractDh1_buildSecrets (hw.x25519_len _ _), hDh1Comm]
    }
  have hAt : badKeyIndFgDh1At P maxLen u bIdx hst.base advRoLog = true := by
    unfold badKeyIndFgDh1At
    rw [hFindP, hFindB]
    dsimp only
    simp only [huCorr, Bool.not_false, hbNotRev, Bool.true_and, Bool.or_eq_true, List.any_eq_true,
      beq_iff_eq]
    exact Or.inl (Or.inl ⟨r.drKeyReal.rootKey, hRoMem, hDh1⟩)
  unfold badKeyIndFgAny
  simp only [Bool.or_eq_true, List.any_eq_true, List.mem_range]
  exact Or.inl ⟨u, huLt, bIdx, hbIdxLt, hAt⟩

theorem badKeyIndFgAny_of_resp_init_drKeyReal_eq {S : Setup} (P : Primitives)
    (hP : CryptoWellFormedPrimitivesδ P) (maxLen : ℕ)
    (hst : KeyIndShCrState S) (advRoLog : List Bytes)
    (hKS : ValidKeyStores S P hst.base)
    (hSidNodup : (hst.base.sessions.map KeyIndInitiatorEntry.sid).Nodup)
    (hSessValid : ∀ s' ∈ hst.base.sessions, ValidInitSession S P hst s')
    (hNoBadKem : hasBadKemShCrRecords S P hst.initKemRecs hst.recvKemRecs = false)
    (hSendLe : hst.sendCount ≤ S.N_send_tot)
    {s : KeyIndInitiatorEntry S} (hsMem : s ∈ hst.base.sessions)
    (hSpkReg : (isGameSpk P hst.base.spkBundles s.peerSpkPk || isAdvRegistered P hst.base.advKeys
      s.peerSpkPk) = true)
    {r : KeyIndRespEntry S} (hr : ValidRespSession S P hst r)
    (hPeer : (isHonestUncorruptedPeer P hst.base.principals r.hdr.ikAPk).isSome = true)
    (hNotRev : (!isSpkRevealed P hst.base.spkBundles r.spkPk) = true)
    (hNotPart : keyIndPartner P s r = false)
    (hKeyEq : s.drKeyReal.rootKey = r.drKeyReal.rootKey) :
    badKeyIndFgAny P maxLen hst.base advRoLog = true := by
  have hw := hP.toWellFormedPrimitivesδ
  have hs := hSessValid s hsMem
  have hNePowSpk : P.pow8 s.peerSpkPk ≠ P.pow8 r.spkPk := by
    intro hPow
    have hPart := drKeyReal_eq_imp_keyIndPartner_of_pow8_spk_eq P hP hst hKS hNoBadKem hSendLe hs hr
      hPow hKeyEq
    rw [hPart] at hNotPart
    nomatch hNotPart
  rcases hKS with ⟨hValPrin, hValSpk, _, hPrins, hSpks, _, hAdvKeys⟩
  rcases exists_uncorrupted_of_isHonestUncorruptedPeer_isSome P hst.base hValPrin hPeer with
    ⟨u, uEntry, huLt, huMem, hFindP, huCorr, hPowIkA⟩
  rcases hr with ⟨k, j, _, bEntry, _, _, _, _, hbMem, _,
    _, hrSpk, _, _, _, _, _, _, _, _, _, _, _, _, _, _, hrOpkCases⟩
  have hbNotRev : (!bEntry.revealed) = true :=
    not_revealed_of_not_isSpkRevealed P hst.base.spkBundles hbMem (congrArg P.pow8 hrSpk) hNotRev
  rcases hs with ⟨_, _, _, _, _, _, _, _, _, _, _,
    u2, u2Entry, _, _, _, hu2Mem, hsIkPk, _, _, _, _, _, _, _, hsKey⟩
  have huIk := hPrins (u, uEntry) huMem
  have hu2Ik := hPrins (u2, u2Entry) hu2Mem
  have hbSpk := hSpks ((k.val, j.val), bEntry) hbMem
  let bIdx := _root_.Proofs.SignalPqxdh.Security.FgGapDh.spkBundleFlatIdxVal S (k.val, j.val)
  have hbIdxLt : bIdx < S.N_spk_tot := spkBundleFlatIdxVal_lt ⟨k.isLt, j.isLt⟩
  have hNodupFlat := spkBundles_nodup_flatIdx hValSpk
  have hFindB : hst.base.spkBundles.find?
      (fun (k', _) => _root_.Proofs.SignalPqxdh.Security.FgGapDh.spkBundleFlatIdxVal S k' == bIdx) =
      some ((k.val, j.val), bEntry) :=
    find?_eq_some_of_nodup_map
      (fun kv => _root_.Proofs.SignalPqxdh.Security.FgGapDh.spkBundleFlatIdxVal S kv.1)
      hNodupFlat hbMem
  have hSpksTarget : ∀ kv ∈ hst.base.spkBundles,
      kv.2.spkSk.length = 32 ∧ kv.2.spkPk = P.x25519Base kv.2.spkSk ∧
      ((_root_.Proofs.SignalPqxdh.Security.FgGapDh.spkBundleFlatIdxVal S kv.1 == bIdx) = true →
        kv.2.spkSk = bEntry.spkSk) := by
    intro kv hkv
    have hkvSpk := hSpks kv hkv
    refine ⟨hkvSpk.1, hkvSpk.2.1, fun hEq => ?_⟩
    have hkvEq := eq_of_nodup_map
      (fun x => _root_.Proofs.SignalPqxdh.Security.FgGapDh.spkBundleFlatIdxVal S x.1)
      hNodupFlat hkv hbMem (beq_iff_eq.mp hEq)
    rw [hkvEq]
  have hNeV : P.pow8 s.peerSpkPk ≠ P.pow8 (P.x25519Base bEntry.spkSk) := by
    rw [← hbSpk.2.1, ← hrSpk]
    exact hNePowSpk
  have hCand : initDh1Cand S P (eraseSpkBundlesFg S bIdx hst.base.spkBundles)
      (hst.base.advKeys.map (fun (sk, pk) => (sk, P.pow8 pk))) s =
      P.x25519 u2Entry.secIKA0 s.peerSpkPk :=
    initDh1Cand_eq_of_ne_target S P hP bIdx bEntry.spkSk hst.base.spkBundles
      (hst.base.advKeys.map (fun (sk, pk) => (sk, P.pow8 pk))) hst.base.advKeys
      s u2Entry.secIKA0 hu2Ik.1 (by rw [hsIkPk, hu2Ik.2]) hSpksTarget
      (spkBundles_length_le_N_dh hValSpk) rfl hAdvKeys hSpkReg hNeV
  have hDh1Eq : P.x25519 u2Entry.secIKA0 s.peerSpkPk = P.x25519 bEntry.spkSk r.hdr.ikAPk := by
    have hExtr := congrArg extractDh1 hKeyEq
    rcases hrOpkCases with ⟨_, _, hrKey⟩ | ⟨_, _, _, _, _, hrKey⟩ <;> {
      rw [hsKey, hrKey, extractDh1_buildSecrets (hw.x25519_len _ _),
          extractDh1_buildSecrets (hw.x25519_len _ _)] at hExtr
      exact hExtr
    }
  have hDh1Comm : P.x25519 bEntry.spkSk r.hdr.ikAPk = P.x25519 uEntry.secIKA0 bEntry.spkPk := by
    have hPowBase : P.pow8 r.hdr.ikAPk = P.pow8 (P.x25519Base uEntry.secIKA0) := by
      rw [hPowIkA, huIk.2]
    rw [x25519_comm_of_pow8_eq P hP bEntry.spkSk uEntry.secIKA0 r.hdr.ikAPk hPowBase, ← hbSpk.2.1]
  have hsTake : s ∈ hst.base.sessions.take S.N_dh := by
    rw [List.take_of_length_le (sessions_length_le_N_dh hSidNodup (fun s' hs' => (hSessValid s'
      hs').1))]
    exact hsMem
  have hAt : badKeyIndFgDh1At P maxLen u bIdx hst.base advRoLog = true := by
    unfold badKeyIndFgDh1At
    rw [hFindP, hFindB]
    dsimp only
    simp only [huCorr, Bool.not_false, hbNotRev, Bool.true_and, Bool.or_eq_true, List.any_eq_true,
      beq_iff_eq]
    exact Or.inl (Or.inr ⟨s, hsTake, by rw [hCand, hDh1Eq, hDh1Comm]⟩)
  unfold badKeyIndFgAny
  simp only [Bool.or_eq_true, List.any_eq_true, List.mem_range]
  exact Or.inl ⟨u, huLt, bIdx, hbIdxLt, hAt⟩

theorem badKeyIndFgAny_of_resp_resp_drKeyReal_eq {S : Setup} (P : Primitives)
    (hP : CryptoWellFormedPrimitivesδ P) (maxLen : ℕ)
    (hst : KeyIndShCrState S) (advRoLog : List Bytes)
    (hKS : ValidKeyStores S P hst.base)
    (hNoEc : hasEcPkCollisionKeyInd P hst.base = false)
    (hRespSidNodup : (hst.base.respSessions.map KeyIndRespEntry.sid).Nodup)
    (hRespBundleNodup : (hst.base.respSessions.map (fun r => (respBundleIdx r.sid,
      r.hdr.ekAPk))).Nodup)
    {r1 r2 : KeyIndRespEntry S}
    (hr1Mem : r1 ∈ hst.base.respSessions) (hr2Mem : r2 ∈ hst.base.respSessions)
    (hr1 : ValidRespSession S P hst r1) (hr2 : ValidRespSession S P hst r2)
    (hPeer : (isHonestUncorruptedPeer P hst.base.principals r1.hdr.ikAPk).isSome = true)
    (hNotRev : (!isSpkRevealed P hst.base.spkBundles r1.spkPk) = true)
    (hNe : r1 ≠ r2)
    (hKeyEq : r1.drKeyReal.rootKey = r2.drKeyReal.rootKey) :
    badKeyIndFgAny P maxLen hst.base advRoLog = true := by
  have hw := hP.toWellFormedPrimitivesδ
  have hNePowSpk : P.pow8 r1.spkPk ≠ P.pow8 r2.spkPk := by
    intro hPow
    exact hNe (resp_drKeyReal_eq_imp_eq_of_pow8_spk_eq P hP hst hKS hNoEc hRespBundleNodup
      hr1Mem hr2Mem hr1 hr2 hPow hKeyEq)
  rcases hKS with ⟨hValPrin, hValSpk, _, hPrins, hSpks, _, _⟩
  rcases exists_uncorrupted_of_isHonestUncorruptedPeer_isSome P hst.base hValPrin hPeer with
    ⟨u, uEntry, huLt, huMem, hFindP, huCorr, hPowIkA⟩
  rcases hr1 with ⟨k1, j1, _, bEntry1, _, _, _, _, hb1Mem, _,
    _, hr1Spk, _, _, _, _, _, _, _, _, _, _, _, _, _, _, hr1OpkCases⟩
  have hb1NotRev : (!bEntry1.revealed) = true :=
    not_revealed_of_not_isSpkRevealed P hst.base.spkBundles hb1Mem (congrArg P.pow8 hr1Spk) hNotRev
  rcases hr2 with ⟨k2, j2, _, bEntry2, _, _, hr2BIdx, _, hb2Mem, _,
    _, hr2Spk, _, _, _, _, _, _, _, _, _, _, _, _, _, _, hr2OpkCases⟩
  have huIk := hPrins (u, uEntry) huMem
  have hb1Spk := hSpks ((k1.val, j1.val), bEntry1) hb1Mem
  let bIdx := _root_.Proofs.SignalPqxdh.Security.FgGapDh.spkBundleFlatIdxVal S (k1.val, j1.val)
  have hbIdxLt : bIdx < S.N_spk_tot := spkBundleFlatIdxVal_lt ⟨k1.isLt, j1.isLt⟩
  have hNodupFlat := spkBundles_nodup_flatIdx hValSpk
  have hFindB1 : hst.base.spkBundles.find?
      (fun (k', _) => _root_.Proofs.SignalPqxdh.Security.FgGapDh.spkBundleFlatIdxVal S k' == bIdx) =
      some ((k1.val, j1.val), bEntry1) :=
    find?_eq_some_of_nodup_map
      (fun kv => _root_.Proofs.SignalPqxdh.Security.FgGapDh.spkBundleFlatIdxVal S kv.1)
      hNodupFlat hb1Mem
  have hNeB : (_root_.Proofs.SignalPqxdh.Security.FgGapDh.spkBundleFlatIdxVal S (k2.val, j2.val) ==
    bIdx) = false := by
    apply Bool.eq_false_iff.mpr
    intro hEq
    have hBundleEq := eq_of_nodup_map
      (fun kv => _root_.Proofs.SignalPqxdh.Security.FgGapDh.spkBundleFlatIdxVal S kv.1)
      hNodupFlat hb2Mem hb1Mem (beq_iff_eq.mp hEq)
    injection hBundleEq with _ hbEq
    subst hbEq
    exact hNePowSpk (by rw [hr1Spk, hr2Spk])
  have hFindB2 : hst.base.spkBundles.find? (fun (idx, _) => idx == respBundleKey r2.sid) =
      some ((k2.val, j2.val), bEntry2) := by
    rw [respBundleKey_eq_of_respBundleIdx hr2BIdx]
    exact find?_eq_some_of_nodup_map Prod.fst (spkBundles_nodup_fst hValSpk) hb2Mem
  have hCand : respDh1Cand S P (eraseSpkBundlesFg S bIdx hst.base.spkBundles) r2 =
      P.x25519 bEntry2.spkSk r2.hdr.ikAPk :=
    respDh1Cand_eq_of_ne_target S P bIdx hst.base.spkBundles r2 (k2.val, j2.val) bEntry2
      (spkBundles_length_le_N_dh hValSpk) hFindB2 hNeB
  have hDh1Eq : P.x25519 bEntry1.spkSk r1.hdr.ikAPk = P.x25519 bEntry2.spkSk r2.hdr.ikAPk := by
    have hExtr := congrArg extractDh1 hKeyEq
    rcases hr1OpkCases with ⟨_, _, hr1Key⟩ | ⟨_, _, _, _, _, hr1Key⟩ <;>
    rcases hr2OpkCases with ⟨_, _, hr2Key⟩ | ⟨_, _, _, _, _, hr2Key⟩ <;> {
      rw [hr1Key, hr2Key, extractDh1_buildSecrets (hw.x25519_len _ _),
          extractDh1_buildSecrets (hw.x25519_len _ _)] at hExtr
      exact hExtr
    }
  have hDh1Comm : P.x25519 bEntry1.spkSk r1.hdr.ikAPk = P.x25519 uEntry.secIKA0 bEntry1.spkPk := by
    have hPowBase : P.pow8 r1.hdr.ikAPk = P.pow8 (P.x25519Base uEntry.secIKA0) := by
      rw [hPowIkA, huIk.2]
    rw [x25519_comm_of_pow8_eq P hP bEntry1.spkSk uEntry.secIKA0 r1.hdr.ikAPk hPowBase, ←
      hb1Spk.2.1]
  have hr2Take : r2 ∈ hst.base.respSessions.take S.N_sess_tot := by
    rw [List.take_of_length_le (respSessions_length_le_N_sess_tot hRespSidNodup)]
    exact hr2Mem
  have hAt : badKeyIndFgDh1At P maxLen u bIdx hst.base advRoLog = true := by
    unfold badKeyIndFgDh1At
    rw [hFindP, hFindB1]
    dsimp only
    simp only [huCorr, Bool.not_false, hb1NotRev, Bool.true_and, Bool.or_eq_true, List.any_eq_true,
      beq_iff_eq]
    exact Or.inr ⟨r2, hr2Take, by rw [hCand, ← hDh1Eq, hDh1Comm]⟩
  unfold badKeyIndFgAny
  simp only [Bool.or_eq_true, List.any_eq_true, List.mem_range]
  exact Or.inl ⟨u, huLt, bIdx, hbIdxLt, hAt⟩

theorem badKeyIndFgAny4_of_init_opkHonest_mem_advRoLog {S : Setup} (P : Primitives)
    (hP : CryptoWellFormedPrimitivesδ P) (maxLen : ℕ)
    (hst : KeyIndShCrState S) (advRoLog : List Bytes)
    (hKS : ValidKeyStores S P hst.base)
    (hSidNodup : (hst.base.sessions.map KeyIndInitiatorEntry.sid).Nodup)
    (hSessValid : ∀ s ∈ hst.base.sessions, ValidInitSession S P hst s)
    {s : KeyIndInitiatorEntry S} (hsMem : s ∈ hst.base.sessions)
    (hFresh : s.fresh = true) (hOpkHon : s.opkHonest = true)
    (hRoMem : s.drKeyReal.rootKey ∈ advRoLog.take maxLen) :
    badKeyIndFgAny4 P maxLen hst.base advRoLog = true := by
  have hw := hP.toWellFormedPrimitivesδ
  have hs := hSessValid s hsMem
  rcases hKS with ⟨_, _, hValOpk, _, _, hOpks, _⟩
  rcases hs with ⟨hSlotLt, _, _, _, _, _, hOpkHonImp, _, _, _, _,
    u, uEntry, kemCoins, ss, initRec, _, _, hEnc, _, _, _, _, _, _, hsKey⟩
  rcases hOpkHonImp hOpkHon with ⟨hSlotOpkLt, k, j, o, oEntry, opkPk, hoMem, hPeerOpk, hPowOpk⟩
  have hFindS : hst.base.sessions.find? (fun s' => initSessionSlotIdx s'.sid == initSessionSlotIdx
    s.sid) = some s :=
    find?_eq_some_of_nodup_map (fun s' => initSessionSlotIdx s'.sid)
      (sessions_nodup_slotIdx hSidNodup (fun s' hs' => (hSessValid s' hs').1)) hsMem
  let oIdx := opkSlotFlatIdx S (k, j, o)
  have hkjoLt := hValOpk.1 ((k, j, o), oEntry) hoMem
  have hoIdxLt : oIdx < S.N_opk_tot := opkSlotFlatIdx_lt S hkjoLt.1 hkjoLt.2.1 hkjoLt.2.2
  have hFindO : hst.base.opkEntries.find?
      (fun (k', _) => opkSlotFlatIdx S k' == oIdx) =
      some ((k, j, o), oEntry) :=
    find?_eq_some_of_nodup_map
      (fun kv => opkSlotFlatIdx S kv.1)
      (opkEntries_nodup_slotIdx hValOpk) hoMem
  have hoOpkPk : oEntry.opkPk = P.x25519Base oEntry.opkSk :=
    (hOpks ((k, j, o), oEntry) hoMem).2
  have hPowOpkBase : P.pow8 opkPk = P.pow8 (P.x25519Base oEntry.opkSk) := by
    rw [← hPowOpk, hoOpkPk]
  have hDh4 : extractDh4 s.drKeyReal.rootKey = P.x25519 s.ekASk oEntry.opkPk := by
    rw [hsKey, hPeerOpk, Option.map_some,
        extractDh4_buildSecrets_some (hw.x25519_len _ _) (hw.x25519_len _ _) (hw.x25519_len _ _)
          (hw.x25519_len _ _),
        hoOpkPk]
    exact hP.x25519_pow8_congr s.ekASk opkPk (P.x25519Base oEntry.opkSk)
      (hP.pow8_base_len opkPk oEntry.opkSk hPowOpkBase)
      (hw.x25519Base_len oEntry.opkSk) hPowOpkBase
  have hAt : badKeyIndFgDh4At P maxLen (initSessionSlotIdx s.sid) oIdx hst.base advRoLog = true :=
    by
    unfold badKeyIndFgDh4At
    rw [hFindS, hFindO]
    simp only [Bool.and_eq_true, beq_iff_eq, List.any_eq_true, hPeerOpk, Option.map_some,
      Option.some.injEq]
    exact ⟨⟨hFresh, hPowOpk.symm⟩, s.drKeyReal.rootKey, hRoMem, hDh4⟩
  unfold badKeyIndFgAny4
  simp only [Bool.or_eq_true, List.any_eq_true, List.mem_range]
  exact Or.inr ⟨initSessionSlotIdx s.sid, hSlotOpkLt, oIdx, hoIdxLt, hAt⟩

theorem badKeyIndFgAny4_of_init_ikUncorrupted_mem_advRoLog {S : Setup} (P : Primitives)
    (hP : CryptoWellFormedPrimitivesδ P) (maxLen : ℕ)
    (hst : KeyIndShCrState S) (advRoLog : List Bytes)
    (hKS : ValidKeyStores S P hst.base)
    (hSidNodup : (hst.base.sessions.map KeyIndInitiatorEntry.sid).Nodup)
    (hSessValid : ∀ s ∈ hst.base.sessions, ValidInitSession S P hst s)
    {s : KeyIndInitiatorEntry S} (hsMem : s ∈ hst.base.sessions)
    (hFresh : s.fresh = true)
    (hPeer : (isHonestUncorruptedPeer P hst.base.principals s.peerIkPk).isSome = true)
    (hRoMem : s.drKeyReal.rootKey ∈ advRoLog.take maxLen) :
    badKeyIndFgAny4 P maxLen hst.base advRoLog = true := by
  have hw := hP.toWellFormedPrimitivesδ
  have hs := hSessValid s hsMem
  rcases hKS with ⟨hValPrin, _, _, hPrins, _, _, _⟩
  rcases exists_uncorrupted_of_isHonestUncorruptedPeer_isSome P hst.base hValPrin hPeer with
    ⟨kIdx, kEntry, hkLt, hkMem, hFindK, hkCorr, hPowIkB⟩
  rcases hs with ⟨hSlotLt, _, _, _, _, _, _, _, _, _, _,
    u, uEntry, kemCoins, ss, initRec, _, _, hEnc, _, _, _, _, _, _, hsKey⟩
  have hFindS : hst.base.sessions.find? (fun s' => initSessionSlotIdx s'.sid == initSessionSlotIdx
    s.sid) = some s :=
    find?_eq_some_of_nodup_map (fun s' => initSessionSlotIdx s'.sid)
      (sessions_nodup_slotIdx hSidNodup (fun s' hs' => (hSessValid s' hs').1)) hsMem
  have hkIkPk : kEntry.ikAPk = P.x25519Base kEntry.secIKA0 :=
    (hPrins (kIdx, kEntry) hkMem).2
  have hPowIkBase : P.pow8 s.peerIkPk = P.pow8 (P.x25519Base kEntry.secIKA0) := by
    rw [hPowIkB, hkIkPk]
  have hDh2 : extractDh2 s.drKeyReal.rootKey = P.x25519 s.ekASk kEntry.ikAPk := by
    rw [hsKey, extractDh2_buildSecrets (hw.x25519_len _ _) (hw.x25519_len _ _), hkIkPk]
    exact hP.x25519_pow8_congr s.ekASk s.peerIkPk (P.x25519Base kEntry.secIKA0)
      (hP.pow8_base_len s.peerIkPk kEntry.secIKA0 hPowIkBase)
      (hw.x25519Base_len kEntry.secIKA0) hPowIkBase
  have hAt : badKeyIndFgDh2At P maxLen (initSessionSlotIdx s.sid) kIdx hst.base advRoLog = true :=
    by
    unfold badKeyIndFgDh2At
    rw [hFindS, hFindK]
    dsimp only
    simp only [Bool.and_eq_true, beq_iff_eq, List.any_eq_true, hkCorr, Bool.not_false]
    exact ⟨⟨⟨hFresh, trivial⟩, hPowIkB⟩, s.drKeyReal.rootKey, hRoMem, hDh2⟩
  unfold badKeyIndFgAny4
  simp only [Bool.or_eq_true, List.any_eq_true, List.mem_range]
  exact Or.inl (Or.inr ⟨initSessionSlotIdx s.sid, hSlotLt, kIdx, hkLt, hAt⟩)

theorem badKeyIndFgAny4_of_isSessionStillFreshKeyInd_mem_advRoLog {S : Setup} (P : Primitives)
    (hP : CryptoWellFormedPrimitivesδ P) (maxLen : ℕ)
    (hst : KeyIndShCrState S) (advRoLog : List Bytes)
    (hKS : ValidKeyStores S P hst.base)
    (hSidNodup : (hst.base.sessions.map KeyIndInitiatorEntry.sid).Nodup)
    (hSessValid : ∀ s ∈ hst.base.sessions, ValidInitSession S P hst s)
    {s : KeyIndInitiatorEntry S} (hsMem : s ∈ hst.base.sessions)
    (hStillFresh : keyIndInitCorruptionClause P true hst.base.principals hst.base.spkBundles s =
      true)
    (hRoMem : s.drKeyReal.rootKey ∈ advRoLog.take maxLen) :
    badKeyIndFgAny4 P maxLen hst.base advRoLog = true := by
  unfold keyIndInitCorruptionClause at hStillFresh
  simp only [↓reduceIte, Bool.and_eq_true, Bool.or_eq_true] at hStillFresh
  rcases hStillFresh with ⟨hFresh, (hPeer | ⟨hSpkHon, hNotRev⟩) | hOpkHon⟩
  · exact badKeyIndFgAny4_of_init_ikUncorrupted_mem_advRoLog P hP maxLen hst advRoLog
      hKS hSidNodup hSessValid hsMem hFresh hPeer hRoMem
  · unfold badKeyIndFgAny4
    simp only [Bool.or_eq_true]
    exact Or.inl (Or.inl (badKeyIndFgAny_of_init_mem_advRoLog P hP maxLen hst advRoLog
      hKS hSidNodup hSessValid hsMem hFresh hSpkHon hNotRev hRoMem))
  · exact badKeyIndFgAny4_of_init_opkHonest_mem_advRoLog P hP maxLen hst advRoLog
      hKS hSidNodup hSessValid hsMem hFresh hOpkHon hRoMem

/-- Combined structural invariant on `adv : KeyIndAdvCutoffState S` maintained by
    `pqxdhKeyIndAdvTagImpl`. -/
def ValidTagState {S : Setup} (P : Primitives) (maxLen : ℕ) (adv : KeyIndAdvCutoffState S) : Prop :=
  adv.advRoLog.length ≤ maxLen ∧
  adv.shCr.sendCount ≤ S.N_send_tot ∧
  ValidKeyStores S P adv.shCr.base ∧
  ValidLazyRand S P adv.shCr.base ∧
  (∀ s ∈ adv.shCr.base.sessions,
    ValidInitSession S P adv.shCr s ∧
    (isGameSpk P adv.shCr.base.spkBundles s.peerSpkPk || isAdvRegistered P adv.shCr.base.advKeys
      s.peerSpkPk) = true) ∧
  (∀ r ∈ adv.shCr.base.respSessions, ValidRespSession S P adv.shCr r)

theorem fresh_imp_spkHonest_and_pqspkHonest_of_hasBadSigKeyInd_false {S : Setup}
    {st : KeyIndState S} (hNoBadSig : hasBadSigKeyInd st = false)
    {s : KeyIndInitiatorEntry S} (hsMem : s ∈ st.sessions) (hFresh : s.fresh = true) :
    s.spkHonest = true ∧ s.pqspkHonest = true := by
  unfold hasBadSigKeyInd HasKeyIndState.toKeyIndState instHasKeyIndStateKeyIndState at hNoBadSig
  rw [List.any_eq_false] at hNoBadSig
  have hS := hNoBadSig s hsMem
  cases h1 : s.spkHonest <;> cases h2 : s.pqspkHonest <;> simp_all

theorem badKeyIndFgAny_imp_badKeyIndFgAny4 {S : Setup} (P : Primitives) (maxLen : ℕ)
    (st : KeyIndState S) (advRoLog : List Bytes)
    (h : badKeyIndFgAny P maxLen st advRoLog = true) :
    badKeyIndFgAny4 P maxLen st advRoLog = true := by
  unfold badKeyIndFgAny4
  simp [h]

theorem badKeyIndFgAny4_of_init_stillFresh_ro5KeyInView {S : Setup} (P : Primitives)
    (hP : CryptoWellFormedPrimitivesδ P) (maxLen : ℕ) (adv : KeyIndAdvCutoffState S)
    (hValid : ValidTagState P maxLen adv)
    (hNoEc : hasEcPkCollisionKeyInd P adv.shCr.base = false)
    (hNoBadSig : hasBadSigKeyInd adv.shCr.base = false)
    (hNoKem : hasKemPkCollisionKeyInd adv.shCr.base = false)
    (hNoBadKem : hasBadKemShCrRecords S P adv.shCr.initKemRecs adv.shCr.recvKemRecs = false)
    {s : KeyIndInitiatorEntry S} (hsMem : s ∈ adv.shCr.base.sessions)
    (hInitFresh : isKeyIndInitStillFresh P true adv.shCr.base.principals adv.shCr.base.spkBundles
      adv.shCr.base.respSessions s = true)
    (hRo5 : ro5KeyInView adv s.drKeyReal.rootKey = true) :
    badKeyIndFgAny4 P maxLen adv.shCr.base adv.advRoLog = true := by
  rcases hValid with ⟨hRoLen, hSendLe, hKS, hRand, hSessBoth, hRespValid⟩
  have hSessValid : ∀ s' ∈ adv.shCr.base.sessions, ValidInitSession S P adv.shCr s' :=
    fun s' hs' => (hSessBoth s' hs').1
  unfold isKeyIndInitStillFresh at hInitFresh
  simp only [Bool.and_eq_true, List.all_eq_true] at hInitFresh
  rcases hInitFresh with ⟨⟨hStillFresh, hNotRevS⟩, hRespAll⟩
  have hFreshS : s.fresh = true := by
    unfold keyIndInitCorruptionClause at hStillFresh
    exact (Bool.and_eq_true _ _).mp hStillFresh |>.1
  have hPqHonS : s.pqspkHonest = true :=
    (fresh_imp_spkHonest_and_pqspkHonest_of_hasBadSigKeyInd_false hNoBadSig hsMem hFreshS).2
  unfold ro5KeyInView at hRo5
  simp only [Bool.or_eq_true, List.contains_iff_mem, List.any_eq_true, Bool.and_eq_true, beq_iff_eq]
    at hRo5
  rcases hRo5 with (hMemLog | ⟨s', hs'Mem, hUnfOrRev, hKeyEq⟩) | ⟨r', hr'Mem, hDishonOrRev, hKeyEq⟩
  · have hTake : s.drKeyReal.rootKey ∈ adv.advRoLog.take maxLen := by
      rw [List.take_of_length_le hRoLen]; exact hMemLog
    exact badKeyIndFgAny4_of_isSessionStillFreshKeyInd_mem_advRoLog P hP maxLen adv.shCr
      adv.advRoLog
      hKS hRand.sid_nodup hSessValid hsMem hStillFresh hTake
  · have hsEq : s' = s :=
      init_eq_of_drKeyReal_eq P hP adv.shCr hNoEc hs'Mem hsMem (hSessValid s' hs'Mem) (hSessValid s
        hsMem) hKeyEq
    subst hsEq
    exfalso
    rcases hUnfOrRev with hUnf | hRev
    · rw [hFreshS] at hUnf; nomatch hUnf
    · rw [hRev] at hNotRevS; nomatch hNotRevS
  · have hPart : keyIndPartner P s r' = true :=
      drKeyReal_eq_imp_keyIndPartner_of_pqspkHonest P hP adv.shCr hKS hNoBadKem hNoKem hSendLe
        (hSessValid s hsMem) (hRespValid r' hr'Mem) hPqHonS hKeyEq.symm
    have hCleanR := hRespAll r' hr'Mem
    simp only [hPart, Bool.not_true, Bool.false_or, Bool.and_eq_true] at hCleanR
    exfalso
    rcases hDishonOrRev with hDishon | hRev
    · rw [hCleanR.1] at hDishon; nomatch hDishon
    · rw [hRev] at hCleanR; exact Bool.noConfusion hCleanR.2

def KeyStoreExtends {S : Setup} (st st' : KeyIndState S) : Prop :=
  (∀ u e, (u, e) ∈ st.principals →
    ∃ e', (u, e') ∈ st'.principals ∧ e'.ikAPk = e.ikAPk ∧ e'.secIKA0 = e.secIKA0) ∧
  (∀ k b, (k, b) ∈ st.spkBundles →
    ∃ b', (k, b') ∈ st'.spkBundles ∧ b'.spkPk = b.spkPk ∧ b'.spkSk = b.spkSk ∧
      b'.pqspkPk = b.pqspkPk ∧ b'.pqspkSk = b.pqspkSk) ∧
  (∀ k o, (k, o) ∈ st.opkEntries →
    ∃ o', (k, o') ∈ st'.opkEntries ∧ o'.opkPk = o.opkPk ∧ o'.opkSk = o.opkSk) ∧
  (∀ kv ∈ st.advKeys, kv ∈ st'.advKeys)

theorem KeyStoreExtends.refl {S : Setup} (st : KeyIndState S) : KeyStoreExtends st st :=
  ⟨fun _ e h => ⟨e, h, rfl, rfl⟩,
   fun _ b h => ⟨b, h, rfl, rfl, rfl, rfl⟩,
   fun _ o h => ⟨o, h, rfl, rfl⟩,
   fun _ h => h⟩

def ShCrExtends {S : Setup} (hst hst' : KeyIndShCrState S) : Prop :=
  KeyStoreExtends hst.base hst'.base ∧
  hst.sendCount ≤ hst'.sendCount ∧
  (∀ r ∈ hst.initKemRecs, r ∈ hst'.initKemRecs) ∧
  (∀ r ∈ hst.recvKemRecs, r ∈ hst'.recvKemRecs) ∧
  (∀ x ∈ hst.base.seenKyberBaseKeys, x ∈ hst'.base.seenKyberBaseKeys)

theorem isGameSpk_or_isAdvRegistered_mono {S : Setup} (P : Primitives)
    {st st' : KeyIndState S} (hExt : KeyStoreExtends st st') {pk : Bytes}
    (h : (isGameSpk P st.spkBundles pk || isAdvRegistered P st.advKeys pk) = true) :
    (isGameSpk P st'.spkBundles pk || isAdvRegistered P st'.advKeys pk) = true := by
  simp only [Bool.or_eq_true, isGameSpk, isAdvRegistered, List.any_eq_true, beq_iff_eq] at h ⊢
  rcases h with ⟨⟨k, b⟩, hb, hPow⟩ | ⟨⟨sk, pk'⟩, hAdv, hPow⟩
  · rcases hExt.2.1 k b hb with ⟨b', hb', hSpkPk, _, _, _⟩
    exact Or.inl ⟨(k, b'), hb', by rw [hSpkPk, hPow]⟩
  · exact Or.inr ⟨(sk, pk'), hExt.2.2.2 (sk, pk') hAdv, hPow⟩

theorem ValidInitSession.mono_shCrExtends {S : Setup} (P : Primitives)
    {hst hst' : KeyIndShCrState S} (hExt : ShCrExtends hst hst')
    {s : KeyIndInitiatorEntry S} (hs : ValidInitSession S P hst s) :
    ValidInitSession S P hst' s := by
  rcases hExt with ⟨⟨hPrinExt, hSpkExt, hOpkExt, _⟩, hSendLe, hInitExt, _, _⟩
  rcases hs with ⟨hSlot, hekLen, hekPk, hFresh, hPeerImp, hSpkImp, hOpkImp, hPqImp,
    hIkKosk, hSpkKosk, hOpkKosk, u, uEntry, kemCoins, ss, initRec,
    huMem, hsIkPk, hEnc, hiMem, hiLt, hiSid, hiPq, hiCt, hiSs, hsKey⟩
  refine ⟨hSlot, hekLen, hekPk, hFresh, ?_, ?_, ?_, ?_, hIkKosk, hSpkKosk, hOpkKosk, ?_⟩
  · intro v hv
    rcases hPeerImp v hv with ⟨vEntry, hvMem, hPow⟩
    rcases hPrinExt v vEntry hvMem with ⟨vEntry', hvMem', hIkEq, _⟩
    exact ⟨vEntry', hvMem', by rw [hIkEq, ← hPow]⟩
  · intro hSpkHon
    rcases hSpkImp hSpkHon with ⟨k, j, bEntry, hbMem, hPow⟩
    rcases hSpkExt (k, j) bEntry hbMem with ⟨bEntry', hbMem', hSpkEq, _, _, _⟩
    exact ⟨k, j, bEntry', hbMem', by rw [hSpkEq, hPow]⟩
  · intro hOpkHon
    rcases hOpkImp hOpkHon with ⟨hSlotOpk, k, j, o, oEntry, opkPk, hoMem, hPeerOpk, hPow⟩
    rcases hOpkExt (k, j, o) oEntry hoMem with ⟨oEntry', hoMem', hOpkEq, _⟩
    exact ⟨hSlotOpk, k, j, o, oEntry', opkPk, hoMem', hPeerOpk, by rw [hOpkEq, hPow]⟩
  · intro hPqHon
    rcases hPqImp hPqHon with ⟨k, j, kEntry, bEntry, hkMem, hbMem, hPowIk, hPqEq⟩
    rcases hPrinExt k kEntry hkMem with ⟨kEntry', hkMem', hIkEq, _⟩
    rcases hSpkExt (k, j) bEntry hbMem with ⟨bEntry', hbMem', _, _, hPqEq', _⟩
    exact ⟨k, j, kEntry', bEntry', hkMem', hbMem', by rw [hIkEq, ← hPowIk], by rw [hPqEq', hPqEq]⟩
  · rcases hPrinExt u uEntry huMem with ⟨uEntry', huMem', hIkEq, hSecEq⟩
    refine ⟨u, uEntry', kemCoins, ss, initRec, huMem', by rw [hIkEq, hsIkPk], hEnc,
      hInitExt initRec hiMem, Nat.lt_of_lt_of_le hiLt hSendLe, hiSid, hiPq, hiCt, hiSs, ?_⟩
    rw [hSecEq, hsKey]

theorem ValidRespSession.mono_shCrExtends {S : Setup} (P : Primitives)
    {hst hst' : KeyIndShCrState S} (hExt : ShCrExtends hst hst')
    {r : KeyIndRespEntry S} (hr : ValidRespSession S P hst r) :
    ValidRespSession S P hst' r := by
  rcases hExt with ⟨⟨hPrinExt, hSpkExt, hOpkExt, _⟩, _, _, hRecvExt, hTriplesExt⟩
  rcases hr with ⟨k, j, kEntry, bEntry, ss, recEntry, hBIdx, hkMem, hbMem, hTrip,
    hrRespIk, hrSpk, hrPq, hrSpkId, hrPqId, hrIkLen, hrEkLen, hrEkCanon, hKoskA, hDec,
    hRecMem, hRecBIdx, hRecPqPk, hRecPqSk, hRecCt, hRecSs, hrOpkCases⟩
  rcases hPrinExt k.val kEntry hkMem with ⟨kEntry', hkMem', hIkEq, hSecEq⟩
  rcases hSpkExt (k.val, j.val) bEntry hbMem with ⟨bEntry', hbMem', hSpkPkEq, hSpkSkEq, hPqPkEq,
    hPqSkEq⟩
  refine ⟨k, j, kEntry', bEntry', ss, recEntry, hBIdx, hkMem', hbMem', hTriplesExt _ hTrip,
    by rw [hIkEq, hrRespIk], by rw [hSpkPkEq, hrSpk], by rw [hPqPkEq, hrPq],
    hrSpkId, hrPqId, hrIkLen, hrEkLen, hrEkCanon, hKoskA, by rw [hPqSkEq, hDec],
    hRecvExt recEntry hRecMem, hRecBIdx, by rw [hPqPkEq, hRecPqPk], by rw [hPqSkEq, hRecPqSk],
    hRecCt, hRecSs, ?_⟩
  rcases hrOpkCases with ⟨hOpkNone, hOpkIdNone, hrKey⟩ | ⟨o, oEntry, hoMem, hrOpkSome, hrOpkIdSome,
    hrKey⟩
  · exact Or.inl ⟨hOpkNone, hOpkIdNone, by rw [hSpkSkEq, hSecEq, hrKey]⟩
  · rcases hOpkExt (k.val, j.val, o) oEntry hoMem with ⟨oEntry', hoMem', hOpkPkEq, hOpkSkEq⟩
    exact Or.inr ⟨o, oEntry', hoMem', by rw [hOpkPkEq, hrOpkSome], hrOpkIdSome,
      by rw [hSpkSkEq, hSecEq, hOpkSkEq, hrKey]⟩

theorem SamePartnerComp.mono_lists {S : Setup} (P : Primitives) {st st' : KeyIndState S}
    (hS : ∀ s ∈ st.sessions, s ∈ st'.sessions)
    (hR : ∀ r ∈ st.respSessions, r ∈ st'.respSessions)
    {x y : KeyIndInitiatorEntry S ⊕ KeyIndRespEntry S}
    (h : SamePartnerComp P st x y) :
    SamePartnerComp P st' x y := by
  induction h with
  | refl x => exact .refl x
  | symm _ ih => exact .symm ih
  | trans _ _ ih1 ih2 => exact .trans ih1 ih2
  | partner hs hr hp => exact .partner (hS _ hs) (hR _ hr) hp

theorem SamePartnerComp.map {S : Setup} (P : Primitives) (st st' : KeyIndState S)
    (fS : KeyIndInitiatorEntry S → KeyIndInitiatorEntry S)
    (fR : KeyIndRespEntry S → KeyIndRespEntry S)
    (hS : ∀ s ∈ st.sessions, fS s ∈ st'.sessions)
    (hR : ∀ r ∈ st.respSessions, fR r ∈ st'.respSessions)
    (hPart : ∀ s r, keyIndPartner P (fS s) (fR r) = keyIndPartner P s r)
    {x y : KeyIndInitiatorEntry S ⊕ KeyIndRespEntry S}
    (h : SamePartnerComp P st x y) :
    SamePartnerComp P st' (Sum.map fS fR x) (Sum.map fS fR y) := by
  induction h with
  | refl x => exact .refl _
  | symm _ ih => exact .symm ih
  | trans _ _ ih1 ih2 => exact .trans ih1 ih2
  | partner hs hr hp => exact .partner (hS _ hs) (hR _ hr) (by rw [hPart]; exact hp)

theorem validLazyRand_empty (S : Setup) (P : Primitives) (secb : Bool) :
    ValidLazyRand S P (KeyIndState.empty S secb) where
  sid_nodup := List.nodup_nil
  resp_sid_nodup := List.nodup_nil
  resp_bundle_nodup := List.nodup_nil
  resp_kyber_mem := fun _ h => nomatch h
  resp_used_opk := fun _ h => nomatch h
  resp_used_no_opk := fun _ h => nomatch h
  init_rand_lt := fun _ h => nomatch h
  resp_rand_lt := fun _ h => nomatch h
  rand_comp := fun x _ hx => by cases x <;> nomatch hx
  partner_rand := fun _ h => nomatch h

theorem validLazyRand_of_eq_fields {S : Setup} (P : Primitives) {st st' : KeyIndState S}
    (hRand : ValidLazyRand S P st)
    (hSess : st'.sessions = st.sessions)
    (hResp : st'.respSessions = st.respSessions)
    (hKyber : ∀ x ∈ st.seenKyberBaseKeys, x ∈ st'.seenKyberBaseKeys)
    (hOpk : ∀ x ∈ st.usedRecvOPK, x ∈ st'.usedRecvOPK)
    (hNoOpk : ∀ x ∈ st.usedRecvNoOPK, x ∈ st'.usedRecvNoOPK) :
    ValidLazyRand S P st' where
  sid_nodup := hSess ▸ hRand.sid_nodup
  resp_sid_nodup := hResp ▸ hRand.resp_sid_nodup
  resp_bundle_nodup := hResp ▸ hRand.resp_bundle_nodup
  resp_kyber_mem := fun r hr k j hIdx =>
    hKyber _ (hRand.resp_kyber_mem r (hResp ▸ hr) k j hIdx)
  resp_used_opk := fun r hr k j o hSid =>
    hOpk _ (hRand.resp_used_opk r (hResp ▸ hr) k j o hSid)
  resp_used_no_opk := fun r hr k j l hSid =>
    hNoOpk _ (hRand.resp_used_no_opk r (hResp ▸ hr) k j l hSid)
  init_rand_lt := fun s hs => by
    rw [hSess, hResp]; exact hRand.init_rand_lt s (hSess ▸ hs)
  resp_rand_lt := fun r hr => by
    rw [hSess, hResp]; exact hRand.resp_rand_lt r (hResp ▸ hr)
  rand_comp := fun x y hx hy hEq => by
    have hx0 : InSessions st x :=
      by cases x <;> dsimp only [InSessions] at hx ⊢ <;> [rw [← hSess]; rw [← hResp]] <;> exact hx
    have hy0 : InSessions st y :=
      by cases y <;> dsimp only [InSessions] at hy ⊢ <;> [rw [← hSess]; rw [← hResp]] <;> exact hy
    exact SamePartnerComp.mono_lists P
      (fun s hs => by rw [hSess]; exact hs)
      (fun r hr => by rw [hResp]; exact hr)
      (hRand.rand_comp x y hx0 hy0 hEq)
  partner_rand := fun s hs r hr hPart => by
    rw [hSess, hResp]
    exact hRand.partner_rand s (hSess ▸ hs) r (hResp ▸ hr) hPart

theorem validLazyRand_of_map_flags {S : Setup} (P : Primitives) {st st' : KeyIndState S}
    (hRand : ValidLazyRand S P st)
    (fS : KeyIndInitiatorEntry S → KeyIndInitiatorEntry S)
    (fR : KeyIndRespEntry S → KeyIndRespEntry S)
    (hSess : st'.sessions = st.sessions.map fS)
    (hResp : st'.respSessions = st.respSessions.map fR)
    (hKyber : st'.seenKyberBaseKeys = st.seenKyberBaseKeys)
    (hOpk : st'.usedRecvOPK = st.usedRecvOPK)
    (hNoOpk : st'.usedRecvNoOPK = st.usedRecvNoOPK)
    (hfS_sid : ∀ s, (fS s).sid = s.sid)
    (hfS_rand : ∀ s, (fS s).drKeyRand = s.drKeyRand)
    (hfR_sid : ∀ r, (fR r).sid = r.sid)
    (hfR_hdr : ∀ r, (fR r).hdr = r.hdr)
    (hfR_rand : ∀ r, (fR r).drKeyRand = r.drKeyRand)
    (hPart : ∀ s r, keyIndPartner P (fS s) (fR r) = keyIndPartner P s r) :
    ValidLazyRand S P st' where
  sid_nodup := by
    rw [hSess, List.map_map]
    have hEq : (KeyIndInitiatorEntry.sid ∘ fS) = KeyIndInitiatorEntry.sid := funext hfS_sid
    rw [hEq]; exact hRand.sid_nodup
  resp_sid_nodup := by
    rw [hResp, List.map_map]
    have hEq : (KeyIndRespEntry.sid ∘ fR) = KeyIndRespEntry.sid := funext hfR_sid
    rw [hEq]; exact hRand.resp_sid_nodup
  resp_bundle_nodup := by
    rw [hResp, List.map_map]
    have hEq : ((fun r : KeyIndRespEntry S => (respBundleIdx r.sid, r.hdr.ekAPk)) ∘ fR) =
        (fun r => (respBundleIdx r.sid, r.hdr.ekAPk)) := by
      funext r; simp [hfR_sid, hfR_hdr]
    rw [hEq]; exact hRand.resp_bundle_nodup
  resp_kyber_mem := by
    intro r' hr' k j hIdx
    rw [hResp, List.mem_map] at hr'
    rcases hr' with ⟨r, hr, rfl⟩
    rw [hfR_sid] at hIdx
    rw [hfR_hdr, hKyber]; exact hRand.resp_kyber_mem r hr k j hIdx
  resp_used_opk := by
    intro r' hr' k j o hSid
    rw [hResp, List.mem_map] at hr'
    rcases hr' with ⟨r, hr, rfl⟩
    rw [hfR_sid] at hSid
    rw [hOpk]; exact hRand.resp_used_opk r hr k j o hSid
  resp_used_no_opk := by
    intro r' hr' k j l hSid
    rw [hResp, List.mem_map] at hr'
    rcases hr' with ⟨r, hr, rfl⟩
    rw [hfR_sid] at hSid
    rw [hNoOpk]; exact hRand.resp_used_no_opk r hr k j l hSid
  init_rand_lt := by
    intro s' hs'
    rw [hSess, List.mem_map] at hs'
    rcases hs' with ⟨s, hs, rfl⟩
    rw [hSess, hResp, List.length_map, List.length_map, hfS_rand]
    exact hRand.init_rand_lt s hs
  resp_rand_lt := by
    intro r' hr'
    rw [hResp, List.mem_map] at hr'
    rcases hr' with ⟨r, hr, rfl⟩
    rw [hSess, hResp, List.length_map, List.length_map, hfR_rand]
    exact hRand.resp_rand_lt r hr
  rand_comp := by
    intro x' y' hx' hy' hEq
    have hPre : ∀ z', InSessions st' z' →
        ∃ z, InSessions st z ∧ z' = Sum.map fS fR z ∧ randRootKey z' = randRootKey z := by
      rintro (s' | r') hz'
      · dsimp only [InSessions] at hz'; rw [hSess, List.mem_map] at hz'
        rcases hz' with ⟨s, hs, rfl⟩
        exact ⟨.inl s, hs, rfl, congrArg DRKey.rootKey (hfS_rand s)⟩
      · dsimp only [InSessions] at hz'; rw [hResp, List.mem_map] at hz'
        rcases hz' with ⟨r, hr, rfl⟩
        exact ⟨.inr r, hr, rfl, congrArg DRKey.rootKey (hfR_rand r)⟩
    rcases hPre x' hx' with ⟨x, hx, rfl, hRx⟩
    rcases hPre y' hy' with ⟨y, hy, rfl, hRy⟩
    rw [hRx, hRy] at hEq
    exact SamePartnerComp.map P st st' fS fR
      (fun s hs => by rw [hSess]; exact List.mem_map_of_mem hs)
      (fun r hr => by rw [hResp]; exact List.mem_map_of_mem hr)
      hPart (hRand.rand_comp x y hx hy hEq)
  partner_rand := by
    intro s' hs' r' hr' hP'
    rw [hSess, List.mem_map] at hs'; rcases hs' with ⟨s, hs, rfl⟩
    rw [hResp, List.mem_map] at hr'; rcases hr' with ⟨r, hr, rfl⟩
    rw [hPart] at hP'
    rcases hRand.partner_rand s hs r hr hP' with
      ⟨r0, hr0, hP0, hEq0⟩ | ⟨s0, hs0, hP0, hEq0⟩
    · left
      refine ⟨fR r0, by rw [hResp]; exact List.mem_map_of_mem hr0, by rw [hPart]; exact hP0, ?_⟩
      rw [hfS_rand, hfR_rand, hEq0]
    · right
      refine ⟨fS s0, by rw [hSess]; exact List.mem_map_of_mem hs0, by rw [hPart]; exact hP0, ?_⟩
      rw [hfR_rand, hfS_rand, hEq0]

theorem inSessions_rand_lt {S : Setup} {P : Primitives} {st : KeyIndState S}
    (hRand : ValidLazyRand S P st) {z : KeyIndInitiatorEntry S ⊕ KeyIndRespEntry S}
    (hz : InSessions st z) :
    (randRootKey z).length < st.sessions.length + st.respSessions.length := by
  cases z with
  | inl s => exact hRand.init_rand_lt s hz
  | inr r => exact hRand.resp_rand_lt r hz

theorem validLazyRand_cons_session {S : Setup} (P : Primitives) {st st' : KeyIndState S}
    (hRand : ValidLazyRand S P st)
    (s : KeyIndInitiatorEntry S)
    (hSess : st'.sessions = s :: st.sessions)
    (hResp : st'.respSessions = st.respSessions)
    (hKyber : ∀ x ∈ st.seenKyberBaseKeys, x ∈ st'.seenKyberBaseKeys)
    (hOpk : ∀ x ∈ st.usedRecvOPK, x ∈ st'.usedRecvOPK)
    (hNoOpk : ∀ x ∈ st.usedRecvNoOPK, x ∈ st'.usedRecvNoOPK)
    (hSidFresh : s.sid ∉ st.sessions.map KeyIndInitiatorEntry.sid)
    (hRandCases :
      (∃ r0 ∈ st.respSessions, keyIndPartner P s r0 = true ∧ s.drKeyRand.rootKey =
        r0.drKeyRand.rootKey) ∨
      ((∀ r ∈ st.respSessions, keyIndPartner P s r = false) ∧
       s.drKeyRand.rootKey.length = st.sessions.length + st.respSessions.length)) :
    ValidLazyRand S P st' where
  sid_nodup := by
    rw [hSess, List.map_cons, List.nodup_cons]
    exact ⟨hSidFresh, hRand.sid_nodup⟩
  resp_sid_nodup := hResp ▸ hRand.resp_sid_nodup
  resp_bundle_nodup := hResp ▸ hRand.resp_bundle_nodup
  resp_kyber_mem := fun r hr k j hIdx =>
    hKyber _ (hRand.resp_kyber_mem r (hResp ▸ hr) k j hIdx)
  resp_used_opk := fun r hr k j o hSid =>
    hOpk _ (hRand.resp_used_opk r (hResp ▸ hr) k j o hSid)
  resp_used_no_opk := fun r hr k j l hSid =>
    hNoOpk _ (hRand.resp_used_no_opk r (hResp ▸ hr) k j l hSid)
  init_rand_lt := by
    intro s' hs'
    rw [hSess, hResp, List.length_cons]
    rw [hSess] at hs'
    rcases List.mem_cons.mp hs' with rfl | hsOld
    · rcases hRandCases with ⟨r0, hr0, _, hEq0⟩ | ⟨_, hLen⟩
      · have hLt0 := hRand.resp_rand_lt r0 hr0
        rw [hEq0]; omega
      · omega
    · have hLtOld := hRand.init_rand_lt s' hsOld
      omega
  resp_rand_lt := by
    intro r' hr'
    rw [hSess, hResp, List.length_cons]
    have hLtOld := hRand.resp_rand_lt r' (hResp ▸ hr')
    omega
  rand_comp := by
    intro x y hx hy hEq
    have hMono : ∀ {a b}, SamePartnerComp P st a b → SamePartnerComp P st' a b :=
      SamePartnerComp.mono_lists P
        (fun s0 hs0 => by rw [hSess]; exact List.mem_cons_of_mem _ hs0)
        (fun r0 hr0 => by rw [hResp]; exact hr0)
    have hInOldOrSelf : ∀ z, InSessions st' z → z = .inl s ∨ InSessions st z := by
      rintro (s' | r') hz
      · dsimp only [InSessions] at hz; rw [hSess] at hz
        rcases List.mem_cons.mp hz with rfl | hsOld
        · exact Or.inl rfl
        · exact Or.inr hsOld
      · dsimp only [InSessions] at hz; rw [hResp] at hz
        exact Or.inr hz
    rcases hRandCases with ⟨r0, hr0, hPart0, hEq0⟩ | ⟨_, hLenS⟩
    · have hLink : SamePartnerComp P st' (.inl s) (.inr r0) :=
        SamePartnerComp.partner (by rw [hSess]; exact List.mem_cons_self)
          (by rw [hResp]; exact hr0) hPart0
      have hRep : ∀ z, InSessions st' z →
          ∃ z0, InSessions st z0 ∧ randRootKey z = randRootKey z0 ∧
            SamePartnerComp P st' z z0 := by
        intro z hz
        rcases hInOldOrSelf z hz with rfl | hzOld
        · exact ⟨.inr r0, hr0, hEq0, hLink⟩
        · exact ⟨z, hzOld, rfl, .refl z⟩
      rcases hRep x hx with ⟨x0, hx0, hRx, hCx⟩
      rcases hRep y hy with ⟨y0, hy0, hRy, hCy⟩
      rw [hRx, hRy] at hEq
      exact hCx.trans ((hMono (hRand.rand_comp x0 y0 hx0 hy0 hEq)).trans hCy.symm)
    · have hNotOld : ∀ z, InSessions st z → randRootKey z ≠ s.drKeyRand.rootKey := by
        intro z hz hEqZ
        have hLtZ := inSessions_rand_lt hRand hz
        rw [hEqZ, hLenS] at hLtZ
        omega
      rcases hInOldOrSelf x hx with rfl | hxOld <;>
        rcases hInOldOrSelf y hy with rfl | hyOld
      · exact .refl (.inl s)
      · exfalso; exact hNotOld y hyOld hEq.symm
      · exfalso; exact hNotOld x hxOld hEq
      · exact hMono (hRand.rand_comp x y hxOld hyOld hEq)
  partner_rand := by
    intro s' hs' r' hr' hP'
    rw [hSess] at hs'; rw [hResp] at hr'
    rcases List.mem_cons.mp hs' with rfl | hsOld
    · rcases hRandCases with ⟨r0, hr0, hPart0, hEq0⟩ | ⟨hNoPart, _⟩
      · exact Or.inl ⟨r0, by rw [hResp]; exact hr0, hPart0, hEq0⟩
      · exfalso; rw [hNoPart r' hr'] at hP'; nomatch hP'
    · rcases hRand.partner_rand s' hsOld r' hr' hP' with
        ⟨r0, hr0, hP0, hEq0⟩ | ⟨s0, hs0, hP0, hEq0⟩
      · exact Or.inl ⟨r0, by rw [hResp]; exact hr0, hP0, hEq0⟩
      · exact Or.inr ⟨s0, by rw [hSess]; exact List.mem_cons_of_mem _ hs0, hP0, hEq0⟩

theorem validLazyRand_cons_respSession {S : Setup} (P : Primitives) {st st' : KeyIndState S}
    (hRand : ValidLazyRand S P st)
    (r : KeyIndRespEntry S)
    (hSess : st'.sessions = st.sessions)
    (hResp : st'.respSessions = r :: st.respSessions)
    (hKyber : ∀ x ∈ st.seenKyberBaseKeys, x ∈ st'.seenKyberBaseKeys)
    (hOpk : ∀ x ∈ st.usedRecvOPK, x ∈ st'.usedRecvOPK)
    (hNoOpk : ∀ x ∈ st.usedRecvNoOPK, x ∈ st'.usedRecvNoOPK)
    (hSidFresh : r.sid ∉ st.respSessions.map KeyIndRespEntry.sid)
    (hBundleFresh : (respBundleIdx r.sid, r.hdr.ekAPk) ∉
      st.respSessions.map (fun r' => (respBundleIdx r'.sid, r'.hdr.ekAPk)))
    (hKyberR : ∀ k j, respBundleIdx r.sid = some (k, j) →
      (k, UInt32.ofNat j, UInt32.ofNat j, r.hdr.ekAPk) ∈ st'.seenKyberBaseKeys)
    (hOpkR : ∀ k j o, r.sid = .recvOPK k j o → (k.val, j.val, o.val) ∈ st'.usedRecvOPK)
    (hNoOpkR : ∀ k j l, r.sid = .recvNoOPK k j l → (k.val, j.val, l.val) ∈ st'.usedRecvNoOPK)
    (hRandCases :
      (∃ s0 ∈ st.sessions, keyIndPartner P s0 r = true ∧ r.drKeyRand.rootKey = s0.drKeyRand.rootKey)
        ∨
      ((∀ s ∈ st.sessions, keyIndPartner P s r = false) ∧
       r.drKeyRand.rootKey.length = st.sessions.length + st.respSessions.length)) :
    ValidLazyRand S P st' where
  sid_nodup := hSess ▸ hRand.sid_nodup
  resp_sid_nodup := by
    rw [hResp, List.map_cons, List.nodup_cons]
    exact ⟨hSidFresh, hRand.resp_sid_nodup⟩
  resp_bundle_nodup := by
    rw [hResp, List.map_cons, List.nodup_cons]
    exact ⟨hBundleFresh, hRand.resp_bundle_nodup⟩
  resp_kyber_mem := by
    intro r' hr' k j hIdx
    rw [hResp] at hr'
    rcases List.mem_cons.mp hr' with rfl | hrOld
    · exact hKyberR k j hIdx
    · exact hKyber _ (hRand.resp_kyber_mem r' hrOld k j hIdx)
  resp_used_opk := by
    intro r' hr' k j o hSid
    rw [hResp] at hr'
    rcases List.mem_cons.mp hr' with rfl | hrOld
    · exact hOpkR k j o hSid
    · exact hOpk _ (hRand.resp_used_opk r' hrOld k j o hSid)
  resp_used_no_opk := by
    intro r' hr' k j l hSid
    rw [hResp] at hr'
    rcases List.mem_cons.mp hr' with rfl | hrOld
    · exact hNoOpkR k j l hSid
    · exact hNoOpk _ (hRand.resp_used_no_opk r' hrOld k j l hSid)
  init_rand_lt := by
    intro s' hs'
    rw [hSess, hResp, List.length_cons]
    have hLtOld := hRand.init_rand_lt s' (hSess ▸ hs')
    omega
  resp_rand_lt := by
    intro r' hr'
    rw [hSess, hResp, List.length_cons]
    rw [hResp] at hr'
    rcases List.mem_cons.mp hr' with rfl | hrOld
    · rcases hRandCases with ⟨s0, hs0, _, hEq0⟩ | ⟨_, hLen⟩
      · have hLt0 := hRand.init_rand_lt s0 hs0
        rw [hEq0]; omega
      · omega
    · have hLtOld := hRand.resp_rand_lt r' hrOld
      omega
  rand_comp := by
    intro x y hx hy hEq
    have hMono : ∀ {a b}, SamePartnerComp P st a b → SamePartnerComp P st' a b :=
      SamePartnerComp.mono_lists P
        (fun s0 hs0 => by rw [hSess]; exact hs0)
        (fun r0 hr0 => by rw [hResp]; exact List.mem_cons_of_mem _ hr0)
    have hInOldOrSelf : ∀ z, InSessions st' z → z = .inr r ∨ InSessions st z := by
      rintro (s' | r') hz
      · dsimp only [InSessions] at hz; rw [hSess] at hz
        exact Or.inr hz
      · dsimp only [InSessions] at hz; rw [hResp] at hz
        rcases List.mem_cons.mp hz with rfl | hrOld
        · exact Or.inl rfl
        · exact Or.inr hrOld
    rcases hRandCases with ⟨s0, hs0, hPart0, hEq0⟩ | ⟨_, hLenR⟩
    · have hLink : SamePartnerComp P st' (.inr r) (.inl s0) :=
        (SamePartnerComp.partner (by rw [hSess]; exact hs0)
          (by rw [hResp]; exact List.mem_cons_self) hPart0).symm
      have hRep : ∀ z, InSessions st' z →
          ∃ z0, InSessions st z0 ∧ randRootKey z = randRootKey z0 ∧
            SamePartnerComp P st' z z0 := by
        intro z hz
        rcases hInOldOrSelf z hz with rfl | hzOld
        · exact ⟨.inl s0, hs0, hEq0, hLink⟩
        · exact ⟨z, hzOld, rfl, .refl z⟩
      rcases hRep x hx with ⟨x0, hx0, hRx, hCx⟩
      rcases hRep y hy with ⟨y0, hy0, hRy, hCy⟩
      rw [hRx, hRy] at hEq
      exact hCx.trans ((hMono (hRand.rand_comp x0 y0 hx0 hy0 hEq)).trans hCy.symm)
    · have hNotOld : ∀ z, InSessions st z → randRootKey z ≠ r.drKeyRand.rootKey := by
        intro z hz hEqZ
        have hLtZ := inSessions_rand_lt hRand hz
        rw [hEqZ, hLenR] at hLtZ
        omega
      rcases hInOldOrSelf x hx with rfl | hxOld <;>
        rcases hInOldOrSelf y hy with rfl | hyOld
      · exact .refl (.inr r)
      · exfalso; exact hNotOld y hyOld hEq.symm
      · exfalso; exact hNotOld x hxOld hEq
      · exact hMono (hRand.rand_comp x y hxOld hyOld hEq)
  partner_rand := by
    intro s' hs' r' hr' hP'
    rw [hSess] at hs'; rw [hResp] at hr'
    rcases List.mem_cons.mp hr' with rfl | hrOld
    · rcases hRandCases with ⟨s0, hs0, hPart0, hEq0⟩ | ⟨hNoPart, _⟩
      · exact Or.inr ⟨s0, by rw [hSess]; exact hs0, hPart0, hEq0⟩
      · exfalso; rw [hNoPart s' hs'] at hP'; nomatch hP'
    · rcases hRand.partner_rand s' hs' r' hrOld hP' with
        ⟨r0, hr0, hP0, hEq0⟩ | ⟨s0, hs0, hP0, hEq0⟩
      · exact Or.inl ⟨r0, by rw [hResp]; exact List.mem_cons_of_mem _ hr0, hP0, hEq0⟩
      · exact Or.inr ⟨s0, by rw [hSess]; exact hs0, hP0, hEq0⟩

theorem acceptKeys_eq_some_imp (P : Primitives) (inp : AcceptKeysInput) {dk : DRKey}
    (h : Model.acceptKeys P inp = some dk) :
    inp.replayOk = true ∧ P.isCanonical inp.hdr.ekAPk = true := by
  refine ⟨?_, ?_⟩
  · cases h1 : inp.replayOk
    · simp [Model.acceptKeys, h1, «guard»] at h
    · rfl
  · cases h2 : P.isCanonical inp.hdr.ekAPk
    · simp [Model.acceptKeys, h2, «guard»] at h
    · rfl

theorem checkAndMarkKyberUsed_eq_imp (usedTriples : List (Nat × KeyId × KeyId × Bytes))
    (k : Nat) (pqspkId spkId : KeyId) (ekAPk : Bytes)
    {replayOk : Bool} {usedTriples' : List (Nat × KeyId × KeyId × Bytes)}
    (h : checkAndMarkKyberBaseKeySeen usedTriples k pqspkId spkId ekAPk = (replayOk, usedTriples'))
    (hOk : replayOk = true) :
    (k, pqspkId, spkId, ekAPk) ∉ usedTriples ∧
    usedTriples' = (k, pqspkId, spkId, ekAPk) :: usedTriples := by
  unfold checkAndMarkKyberBaseKeySeen at h
  dsimp only at h
  subst hOk
  split_ifs at h with hMem
  · cases h
  · injection h with _ hEq
    refine ⟨?_, hEq.symm⟩
    intro hIn
    rw [List.contains_iff_mem.mpr hIn] at hMem
    nomatch hMem

theorem exists_sk_of_isGameIdKey_or_isAdvRegistered {S : Setup} (P : Primitives)
    {st : KeyIndState S} (hKS : ValidKeyStores S P st) {pk : Bytes}
    (h : (isGameIdKey P st.principals pk || isAdvRegistered P st.advKeys pk) = true) :
    ∃ sk, sk.length = 32 ∧ P.pow8 pk = P.pow8 (P.x25519Base sk) := by
  rcases hKS with ⟨_, _, _, hPrins, _, _, hAdvKeys⟩
  simp only [Bool.or_eq_true, isGameIdKey, findHonestPrincipal, Option.isSome_iff_exists,
    isAdvRegistered, List.any_eq_true, beq_iff_eq] at h
  rcases h with ⟨⟨u, uEntry⟩, hFind⟩ | ⟨⟨sk, pk'⟩, hMem, hPow⟩
  · have hMem := List.mem_of_find?_eq_some hFind
    have hPow : P.pow8 pk = P.pow8 uEntry.ikAPk := by
      have h0 := List.find?_some hFind
      exact beq_iff_eq.mp h0
    rcases hPrins (u, uEntry) hMem with ⟨hLen, hBase⟩
    exact ⟨uEntry.secIKA0, hLen, by rw [hPow, hBase]⟩
  · rcases hAdvKeys (sk, pk') hMem with ⟨hLen, hBase⟩
    exact ⟨sk, hLen, by rw [hPow, hBase]⟩

theorem exists_sk_of_isGameSpk_or_isAdvRegistered {S : Setup} (P : Primitives)
    {st : KeyIndState S} (hKS : ValidKeyStores S P st) {pk : Bytes}
    (h : (isGameSpk P st.spkBundles pk || isAdvRegistered P st.advKeys pk) = true) :
    ∃ sk, sk.length = 32 ∧ P.pow8 pk = P.pow8 (P.x25519Base sk) := by
  rcases hKS with ⟨_, _, _, _, hSpks, _, hAdvKeys⟩
  simp only [Bool.or_eq_true, isGameSpk, isAdvRegistered, List.any_eq_true, beq_iff_eq] at h
  rcases h with ⟨⟨kj, bEntry⟩, hMem, hPow⟩ | ⟨⟨sk, pk'⟩, hMem, hPow⟩
  · rcases hSpks (kj, bEntry) hMem with ⟨hLen, hBase, _⟩
    exact ⟨bEntry.spkSk, hLen, by rw [← hPow, hBase]⟩
  · rcases hAdvKeys (sk, pk') hMem with ⟨hLen, hBase⟩
    exact ⟨sk, hLen, by rw [hPow, hBase]⟩

theorem exists_sk_of_isGameOpk_or_isAdvRegistered {S : Setup} (P : Primitives)
    {st : KeyIndState S} (hKS : ValidKeyStores S P st) {pk : Bytes}
    (h : (isGameOpk P st.opkEntries pk || isAdvRegistered P st.advKeys pk) = true) :
    ∃ sk, sk.length = 32 ∧ P.pow8 pk = P.pow8 (P.x25519Base sk) := by
  rcases hKS with ⟨_, _, _, _, _, hOpks, hAdvKeys⟩
  simp only [Bool.or_eq_true, isGameOpk, isAdvRegistered, List.any_eq_true, beq_iff_eq] at h
  rcases h with ⟨⟨kjo, oEntry⟩, hMem, hPow⟩ | ⟨⟨sk, pk'⟩, hMem, hPow⟩
  · rcases hOpks (kjo, oEntry) hMem with ⟨hLen, hBase⟩
    exact ⟨oEntry.opkSk, hLen, by rw [← hPow, hBase]⟩
  · rcases hAdvKeys (sk, pk') hMem with ⟨hLen, hBase⟩
    exact ⟨sk, hLen, by rw [hPow, hBase]⟩

