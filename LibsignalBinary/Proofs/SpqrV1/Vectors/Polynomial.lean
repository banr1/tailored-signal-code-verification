/-!
# Differential Test Vectors for `PolyEncoder` and `PolyDecoder`

Deterministic `spqr-vectors` bundles for message sizes 64, 96, 160, 960, and 1152 bytes,
covering `Points` / `Polys` protobuf states and Lagrange reconstruction scenarios.
-/

@[expose] public section

namespace CryptoVerification.SpqrV1.Vectors.Polynomial

def hexNibble (c : Char) : BitVec 8 :=
  let v := c.val.toBitVec.truncate 8
  if v ≥ 0x30#8 && v ≤ 0x39#8 then v - 0x30#8
  else if v ≥ 0x61#8 && v ≤ 0x66#8 then v - 0x61#8 + 10#8
  else if v ≥ 0x41#8 && v ≤ 0x46#8 then v - 0x41#8 + 10#8
  else 0#8

def unhexChars : List Char → List (BitVec 8)
  | a :: b :: rest => ((hexNibble a <<< 4) ||| hexNibble b) :: unhexChars rest
  | _ => []

def unhex (s : String) : List (BitVec 8) :=
  unhexChars s.toList

def unhexArray (s : String) : Array (BitVec 8) :=
  (unhex s).toArray

/-- A 32-byte erasure-coding chunk (`src/encoding.rs:25–28`). -/
structure ChunkVec where
  index : BitVec 16
  data : List (BitVec 8)
  deriving DecidableEq, Repr

/-- One `PolyDecoder` reconstruction scenario for a given message. -/
structure DecoderScenarioVec where
  name : String
  msgLen : Nat
  chunkIndices : List (BitVec 16)
  completedAtStep : Option Nat
  midPbStep : Nat
  midDecoderPb : List (BitVec 8)
  deriving DecidableEq, Repr

/-- `PolyEncoder` and `PolyDecoder` test bundle for one message size. -/
structure PolyMsgTestVec where
  msgLen : Nat
  msg : List (BitVec 8)
  pointsEncoderPb : List (BitVec 8)
  polysEncoderPb : List (BitVec 8)
  chunks : List ChunkVec
  scenarios : List DecoderScenarioVec
  deriving DecidableEq, Repr

