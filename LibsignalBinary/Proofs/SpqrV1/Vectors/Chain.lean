module

/-!
# Differential Test Vectors for `Chain`, `ChainEpochDirection`, and `KeyHistory`

Deterministic `spqr-vectors` traces covering out-of-order key storage, swap-removal,
`KeyHistory::gc`, large-jump clearing, and multi-epoch `Chain::send_key` / `Chain::recv_key`.
-/

@[expose] public section

namespace CryptoVerification.SpqrV1.Vectors.Chain

def hexNibble (c : Char) : BitVec 8 :=
  let v := c.val.toBitVec.truncate 8
  if v ≥ 0x30#8 && v ≤ 0x39#8 then v - 0x30#8
  else if v ≥ 0x61#8 && v ≤ 0x66#8 then v - 0x61#8 + 10#8
  else if v ≥ 0x41#8 && v ≤ 0x46#8 then v - 0x41#8 + 10#8
  else 0#8

def unhexChars : List Char → List (BitVec 8)
  | a :: b :: rest => ((hexNibble a <<< 4) ||| hexNibble b) :: unhexChars rest
  | _ => []

def unhex (s : String) : List (BitVec 8) :=
  unhexChars s.toList

def unhexArray (s : String) : Array (BitVec 8) :=
  (unhex s).toArray

/-- Result of a `ChainEpochDirection` or `Chain` key operation. -/
inductive KeyOpResult where
  | okKey (key : List (BitVec 8))
  | okIdxKey (index : BitVec 32) (key : List (BitVec 8))
  | err (tag : String)
  deriving DecidableEq, Repr

/-- Step in a `ChainEpochDirection` + `KeyHistory` trace. -/
structure CedStepVec where
  op : String
  arg : BitVec 32
  result : KeyOpResult
  ctrAfter : BitVec 32
  nextAfter : List (BitVec 8)
  prevDataAfter : List (BitVec 8)
  deriving DecidableEq, Repr

/-- Step in a full multi-epoch `Chain` trace. -/
structure ChainStepVec where
  op : String
  epoch : BitVec 64
  indexOrSecret : List (BitVec 8)
  indexArg : BitVec 32
  result : KeyOpResult
  chainPbAfter : List (BitVec 8)
  deriving DecidableEq, Repr

