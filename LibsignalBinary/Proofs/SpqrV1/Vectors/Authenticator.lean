/-!
# Differential Test Vectors for `Authenticator`

Deterministic `spqr-vectors` test suite covering `Authenticator::new`, `update`, `mac_hdr`,
`mac_ct`, `verify_hdr`, `verify_ct`, and protobuf serialization.
-/

@[expose] public section

namespace CryptoVerification.SpqrV1.Vectors.Authenticator

def hexNibble (c : Char) : BitVec 8 :=
  let v := c.val.toBitVec.truncate 8
  if v ≥ 0x30#8 && v ≤ 0x39#8 then v - 0x30#8
  else if v ≥ 0x61#8 && v ≤ 0x66#8 then v - 0x61#8 + 10#8
  else if v ≥ 0x41#8 && v ≤ 0x46#8 then v - 0x41#8 + 10#8
  else 0#8

def unhexChars : List Char → List (BitVec 8)
  | a :: b :: rest => ((hexNibble a <<< 4) ||| hexNibble b) :: unhexChars rest
  | _ => []

def unhex (s : String) : List (BitVec 8) :=
  unhexChars s.toList

def unhexArray (s : String) : Array (BitVec 8) :=
  (unhex s).toArray

/-- Vector for `Authenticator::new` and `Authenticator::update`. -/
structure AuthUpdateVec where
  rootKeyBefore : List (BitVec 8)
  macKeyBefore : List (BitVec 8)
  epoch : BitVec 64
  inputKey : List (BitVec 8)
  rootKeyAfter : List (BitVec 8)
  macKeyAfter : List (BitVec 8)
  pbBytesAfter : List (BitVec 8)
  deriving DecidableEq, Repr

/-- Vector for `mac_hdr`, `mac_ct`, `verify_hdr`, and `verify_ct`. -/
structure AuthMacVerifyVec where
  rootKey : List (BitVec 8)
  macKey : List (BitVec 8)
  epoch : BitVec 64
  payload : List (BitVec 8)
  hdrMac : List (BitVec 8)
  ctMac : List (BitVec 8)
  candidateMac : List (BitVec 8)
  verifyHdrOk : Bool
  verifyCtOk : Bool
  deriving DecidableEq, Repr

