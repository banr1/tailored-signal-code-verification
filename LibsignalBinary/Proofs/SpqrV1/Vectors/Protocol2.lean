module

/-!
# Shared Types and Blob Data for `Vectors/Protocol.lean`

Data structures (`MlKemCallVec`, `ProtocolStepVec`, `ProtocolRunVec`, `TamperedRecvVec`,
`StateRoundTripVec`) and shared byte-blob definitions imported by `Vectors/Protocol.lean`.
-/

@[expose] public section

namespace CryptoVerification.SpqrV1.Vectors.Protocol

def hexNibble (c : Char) : BitVec 8 :=
  let v := c.val.toBitVec.truncate 8
  if v ≥ 0x30#8 && v ≤ 0x39#8 then v - 0x30#8
  else if v ≥ 0x61#8 && v ≤ 0x66#8 then v - 0x61#8 + 10#8
  else if v ≥ 0x41#8 && v ≤ 0x46#8 then v - 0x41#8 + 10#8
  else 0#8

def unhexChars : List Char → List (BitVec 8)
  | a :: b :: rest => ((hexNibble a <<< 4) ||| hexNibble b) :: unhexChars rest
  | _ => []

def unhex (s : String) : List (BitVec 8) :=
  unhexChars s.toList

def unhexArray (s : String) : Array (BitVec 8) :=
  (unhex s).toArray

/-- Recorded libcrux ML-KEM-768 call during an SPQR V1 step (`src/incremental_mlkem768.rs`). -/
inductive MlKemCallVec where
  | fromSeed (seed hdr ek dk : List (BitVec 8))
  | encaps1 (hdr rand ct1 es ss : List (BitVec 8))
  | encaps2 (es ek ct2 : List (BitVec 8))
  | decaps (dk ct1 ct2 ss : List (BitVec 8))
  | validatePk (hdr ek : List (BitVec 8)) (valid : Bool)
  deriving DecidableEq, Repr

/-- One `spqr::send` or `spqr::recv` step in a full V1 protocol run. -/
structure ProtocolStepVec where
  actor : String
  op : String
  stateBytes : List (BitVec 8)
  msgOrTape : List (BitVec 8)
  newState : List (BitVec 8)
  key : Option (List (BitVec 8))
  msg : List (BitVec 8)
  mlkemCalls : List MlKemCallVec
  deriving DecidableEq, Repr

/-- A full Alice/Bob V1 protocol run. -/
structure ProtocolRunVec where
  name : String
  messagesSent : Nat
  aliceInitialState : List (BitVec 8)
  bobInitialState : List (BitVec 8)
  steps : List ProtocolStepVec
  deriving DecidableEq, Repr

/-- Tampered-message `spqr::recv` vector expecting `Err`. -/
structure TamperedRecvVec where
  name : String
  stateBytes : List (BitVec 8)
  tamperedMsg : List (BitVec 8)
  expectedError : String
  mlkemCalls : List MlKemCallVec
  deriving DecidableEq, Repr

/-- State serialization round-trip (`decode_state ∘ encode`) vector. -/
structure StateRoundTripVec where
  label : String
  variant : String
  stateBytes : List (BitVec 8)
  deriving DecidableEq, Repr

